<?xml version="1.0" encoding="utf-8"?>
<!--
    Gauge control vocabulary (docs/design/gauge/COMPONENTS.md) as reusable XAML styles.
    Colours come only from the Gauge*Brush roles in GaugeTheme.xaml. Later screens compose
    these; they should not need their own colours.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===================================================================================
         Buttons: 26px min height, 3x11 padding, r-2 corners. Secondary by default, one
         accent-filled primary per view, ghost in headers and toolbars.
         ================================================================================= -->

    <Style x:Key="GaugeButtonBase" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource GaugeBg3Brush}" />
        <Setter Property="Foreground" Value="{ThemeResource GaugeFg0Brush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource GaugeLine2Brush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource GaugeR2}" />
        <Setter Property="Padding" Value="11,3" />
        <Setter Property="MinHeight" Value="26" />
        <Setter Property="FontFamily" Value="{StaticResource GaugeSans}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="FocusVisualMargin" Value="-4" />
        <Setter Property="FocusVisualPrimaryThickness" Value="2" />
        <Setter Property="FocusVisualSecondaryThickness" Value="0" />
        <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource GaugeAccentBrush}" />
        <Setter Property="BackgroundSizing" Value="InnerBorderEdge" />
    </Style>

    <!--  Secondary: bg-3 / line-2 / fg-0, hover bg-4.  -->
    <Style
        x:Key="GaugeButton"
        BasedOn="{StaticResource GaugeButtonBase}"
        TargetType="Button">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid
                        x:Name="Root"
                        Background="{TemplateBinding Background}"
                        BackgroundSizing="{TemplateBinding BackgroundSizing}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource GaugeBg4Brush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource GaugeBg4Brush}" />
                                        <Setter Target="Root.BorderBrush" Value="{ThemeResource GaugeLineCtlBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Opacity" Value="0.45" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <ContentPresenter
                            x:Name="ContentPresenter"
                            Padding="{TemplateBinding Padding}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                            AutomationProperties.AccessibilityView="Raw"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            ContentTransitions="{TemplateBinding ContentTransitions}"
                            FontWeight="{TemplateBinding FontWeight}"
                            Foreground="{TemplateBinding Foreground}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Ghost: no fill, line-ctl border (its only boundary), hover bg-3.  -->
    <Style
        x:Key="GaugeGhostButton"
        BasedOn="{StaticResource GaugeButtonBase}"
        TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{ThemeResource GaugeLineCtlBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid
                        x:Name="Root"
                        Background="{TemplateBinding Background}"
                        BackgroundSizing="{TemplateBinding BackgroundSizing}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource GaugeBg3Brush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource GaugeBg4Brush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Opacity" Value="0.45" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <ContentPresenter
                            x:Name="ContentPresenter"
                            Padding="{TemplateBinding Padding}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                            AutomationProperties.AccessibilityView="Raw"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            ContentTransitions="{TemplateBinding ContentTransitions}"
                            FontWeight="{TemplateBinding FontWeight}"
                            Foreground="{TemplateBinding Foreground}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Icon-only ghost button: 15px glyph, 3x6 padding, so it sits at 26px square-ish.  -->
    <Style
        x:Key="GaugeIconButton"
        BasedOn="{StaticResource GaugeGhostButton}"
        TargetType="Button">
        <Setter Property="Padding" Value="6,3" />
        <Setter Property="MinWidth" Value="28" />
    </Style>

    <!--  Primary: accent fill and border, accent-ink text, 600. At most one per view.  -->
    <Style
        x:Key="GaugePrimaryButton"
        BasedOn="{StaticResource GaugeButtonBase}"
        TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource GaugeAccentBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource GaugeAccentBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource GaugeAccentInkBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid
                        x:Name="Root"
                        Background="{TemplateBinding Background}"
                        BackgroundSizing="{TemplateBinding BackgroundSizing}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Sheen.Opacity" Value="0.10" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Sheen.Opacity" Value="0.18" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Opacity" Value="0.45" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <!--  brightness(1.08) on hover: a faint white sheen over the accent.  -->
                        <Border
                            x:Name="Sheen"
                            Background="White"
                            Opacity="0" />
                        <ContentPresenter
                            x:Name="ContentPresenter"
                            Padding="{TemplateBinding Padding}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                            AutomationProperties.AccessibilityView="Raw"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            ContentTransitions="{TemplateBinding ContentTransitions}"
                            FontWeight="{TemplateBinding FontWeight}"
                            Foreground="{TemplateBinding Foreground}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Toggle (aria-pressed): a ghost button whose checked state is an accent border and text.  -->
    <Style x:Key="GaugeToggleButton" TargetType="ToggleButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{ThemeResource GaugeFg0Brush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource GaugeLineCtlBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource GaugeR2}" />
        <Setter Property="Padding" Value="11,3" />
        <Setter Property="MinHeight" Value="26" />
        <Setter Property="FontFamily" Value="{StaticResource GaugeSans}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="FocusVisualMargin" Value="-4" />
        <Setter Property="FocusVisualPrimaryThickness" Value="2" />
        <Setter Property="FocusVisualSecondaryThickness" Value="0" />
        <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource GaugeAccentBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid
                        x:Name="Root"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource GaugeBg3Brush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource GaugeBg4Brush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Opacity" Value="0.45" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Checked">
                                    <VisualState.Setters>
                                        <Setter Target="Root.BorderBrush" Value="{ThemeResource GaugeAccentBrush}" />
                                        <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource GaugeAccentBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="CheckedPointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource GaugeBg3Brush}" />
                                        <Setter Target="Root.BorderBrush" Value="{ThemeResource GaugeAccentBrush}" />
                                        <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource GaugeAccentBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="CheckedPressed">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource GaugeBg3Brush}" />
                                        <Setter Target="Root.BorderBrush" Value="{ThemeResource GaugeAccentBrush}" />
                                        <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource GaugeAccentBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="CheckedDisabled">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Opacity" Value="0.45" />
                                        <Setter Target="Root.BorderBrush" Value="{ThemeResource GaugeAccentBrush}" />
                                        <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource GaugeAccentBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Indeterminate" />
                                <VisualState x:Name="IndeterminatePointerOver" />
                                <VisualState x:Name="IndeterminatePressed" />
                                <VisualState x:Name="IndeterminateDisabled" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <ContentPresenter
                            x:Name="ContentPresenter"
                            Padding="{TemplateBinding Padding}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                            AutomationProperties.AccessibilityView="Raw"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Foreground="{TemplateBinding Foreground}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================================================================================
         Fields: bg-0 fill, line-ctl border (the only boundary), 26px, 3x8 padding, fg-3
         placeholder. The Fluent templates are kept; their sizing resources are overridden
         here and their brushes in GaugeTheme.xaml.
         ================================================================================= -->

    <x:Double x:Key="TextControlThemeMinHeight">26</x:Double>
    <Thickness x:Key="TextControlThemePadding">8,3,6,3</Thickness>
    <Thickness x:Key="TextControlBorderThemeThicknessFocused">1</Thickness>
    <x:Double x:Key="ComboBoxMinHeight">26</x:Double>
    <Thickness x:Key="ComboBoxPadding">8,2,0,3</Thickness>
    <x:Double x:Key="CheckBoxSize">14</x:Double>
    <x:Double x:Key="CheckBoxGlyphSize">10</x:Double>
    <x:Double x:Key="CheckBoxHeight">20</x:Double>
    <x:Double x:Key="CheckBoxMinWidth">0</x:Double>
    <Thickness x:Key="CheckBoxPadding">6,0,0,0</Thickness>

    <Style
        x:Key="GaugeTextBox"
        BasedOn="{StaticResource DefaultTextBoxStyle}"
        TargetType="TextBox">
        <Setter Property="Background" Value="{ThemeResource GaugeBg0Brush}" />
        <Setter Property="Foreground" Value="{ThemeResource GaugeFg0Brush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource GaugeLineCtlBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource GaugeR2}" />
        <Setter Property="MinHeight" Value="26" />
        <Setter Property="Padding" Value="8,3,6,3" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="PlaceholderForeground" Value="{ThemeResource GaugeFg3Brush}" />
        <Setter Property="SelectionHighlightColor" Value="{ThemeResource GaugeAccentBrush}" />
    </Style>
    <Style BasedOn="{StaticResource GaugeTextBox}" TargetType="TextBox" />

    <!--  Monospace field for identifiers, servers and values.  -->
    <Style
        x:Key="GaugeMonoTextBox"
        BasedOn="{StaticResource GaugeTextBox}"
        TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource GaugeMono}" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style
        x:Key="GaugePasswordBox"
        BasedOn="{StaticResource DefaultPasswordBoxStyle}"
        TargetType="PasswordBox">
        <Setter Property="Background" Value="{ThemeResource GaugeBg0Brush}" />
        <Setter Property="Foreground" Value="{ThemeResource GaugeFg0Brush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource GaugeLineCtlBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource GaugeR2}" />
        <Setter Property="MinHeight" Value="26" />
        <Setter Property="Padding" Value="8,3,6,3" />
        <Setter Property="FontSize" Value="13" />
    </Style>
    <Style BasedOn="{StaticResource GaugePasswordBox}" TargetType="PasswordBox" />

    <Style
        x:Key="GaugeComboBox"
        BasedOn="{StaticResource DefaultComboBoxStyle}"
        TargetType="ComboBox">
        <Setter Property="Background" Value="{ThemeResource GaugeBg0Brush}" />
        <Setter Property="Foreground" Value="{ThemeResource GaugeFg0Brush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource GaugeLineCtlBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource GaugeR2}" />
        <Setter Property="MinHeight" Value="26" />
        <Setter Property="Padding" Value="8,2,0,3" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="FocusVisualMargin" Value="-4" />
        <Setter Property="FocusVisualPrimaryThickness" Value="2" />
        <Setter Property="FocusVisualSecondaryThickness" Value="0" />
        <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource GaugeAccentBrush}" />
    </Style>
    <Style BasedOn="{StaticResource GaugeComboBox}" TargetType="ComboBox" />

    <!--  Compact field for a status bar: 20px, 11.5px type.  -->
    <Style
        x:Key="GaugeCompactComboBox"
        BasedOn="{StaticResource GaugeComboBox}"
        TargetType="ComboBox">
        <Setter Property="MinHeight" Value="20" />
        <Setter Property="Height" Value="20" />
        <Setter Property="Padding" Value="5,0,0,1" />
        <Setter Property="FontSize" Value="11.5" />
    </Style>

    <Style BasedOn="{StaticResource DefaultComboBoxItemStyle}" TargetType="ComboBoxItem">
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="MinHeight" Value="26" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style
        x:Key="GaugeAutoSuggestBox"
        BasedOn="{StaticResource DefaultAutoSuggestBoxStyle}"
        TargetType="AutoSuggestBox">
        <Setter Property="MinHeight" Value="26" />
        <Setter Property="FontSize" Value="13" />
    </Style>
    <Style BasedOn="{StaticResource GaugeAutoSuggestBox}" TargetType="AutoSuggestBox" />

    <Style x:Key="GaugeNumberBox" TargetType="NumberBox">
        <Setter Property="MinHeight" Value="26" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="CornerRadius" Value="{StaticResource GaugeR2}" />
    </Style>
    <Style BasedOn="{StaticResource GaugeNumberBox}" TargetType="NumberBox" />

    <Style
        x:Key="GaugeCheckBox"
        BasedOn="{StaticResource DefaultCheckBoxStyle}"
        TargetType="CheckBox">
        <Setter Property="MinHeight" Value="20" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Padding" Value="6,0,0,0" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{ThemeResource GaugeFg1Brush}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource GaugeAccentBrush}" />
    </Style>
    <Style BasedOn="{StaticResource GaugeCheckBox}" TargetType="CheckBox" />

    <!-- ===================================================================================
         Segmented control: a GaugeSegmented border around a horizontal StackPanel of
         GaugeSegmentItem RadioButtons sharing a GroupName, which gives exactly-one-selected
         for free. 22px, 2x10 padding, 12px type; line-ctl outside, line-2 dividers; off fg-2,
         hover bg-3, on bg-4 / fg-0 / 600. Put GaugeSegmentItemFirst on the first item so it
         has no leading divider.
         ================================================================================= -->

    <Style x:Key="GaugeSegmented" TargetType="Border">
        <Setter Property="BorderBrush" Value="{ThemeResource GaugeLineCtlBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource GaugeR2}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style x:Key="GaugeSegmentItem" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{ThemeResource GaugeFg2Brush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{ThemeResource GaugeLine2Brush}" />
        <Setter Property="BorderThickness" Value="1,0,0,0" />
        <Setter Property="Padding" Value="10,2" />
        <Setter Property="MinHeight" Value="22" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="FontFamily" Value="{StaticResource GaugeSans}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <!--  Inside a clipped container the ring sits inside the item (-2px offset).  -->
        <Setter Property="FocusVisualMargin" Value="0" />
        <Setter Property="FocusVisualPrimaryThickness" Value="2" />
        <Setter Property="FocusVisualSecondaryThickness" Value="0" />
        <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource GaugeAccentBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid
                        x:Name="Root"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Hover.Opacity" Value="1" />
                                        <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource GaugeFg0Brush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Hover.Opacity" Value="1" />
                                        <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource GaugeFg0Brush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Opacity" Value="0.45" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="CheckStates">
                                <VisualState x:Name="Checked">
                                    <VisualState.Setters>
                                        <Setter Target="On.Opacity" Value="1" />
                                        <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource GaugeFg0Brush}" />
                                        <Setter Target="ContentPresenter.FontWeight" Value="SemiBold" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Unchecked" />
                                <VisualState x:Name="Indeterminate" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Border
                            x:Name="Hover"
                            Background="{ThemeResource GaugeBg3Brush}"
                            Opacity="0" />
                        <Border
                            x:Name="On"
                            Background="{ThemeResource GaugeBg4Brush}"
                            Opacity="0" />
                        <ContentPresenter
                            x:Name="ContentPresenter"
                            Padding="{TemplateBinding Padding}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                            AutomationProperties.AccessibilityView="Raw"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Foreground="{TemplateBinding Foreground}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style
        x:Key="GaugeSegmentItemFirst"
        BasedOn="{StaticResource GaugeSegmentItem}"
        TargetType="RadioButton">
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!-- ===================================================================================
         Text: severity is always a word (colour only reinforces it); entities are underlined
         text, never badges.
         ================================================================================= -->

    <Style x:Key="GaugeSevNeutral" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource GaugeFg2Brush}" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>
    <Style
        x:Key="GaugeSevCrit"
        BasedOn="{StaticResource GaugeSevNeutral}"
        TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource GaugeCritBrush}" />
    </Style>
    <Style
        x:Key="GaugeSevWarn"
        BasedOn="{StaticResource GaugeSevNeutral}"
        TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource GaugeWarnBrush}" />
    </Style>
    <Style
        x:Key="GaugeSevOk"
        BasedOn="{StaticResource GaugeSevNeutral}"
        TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource GaugeOkBrush}" />
    </Style>

    <!--  12px fg-3 count beside a label (fg-2 where it sits on bg-3 or bg-4).  -->
    <Style x:Key="GaugeCount" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{ThemeResource GaugeFg3Brush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!--  Keyboard key: 11px mono, bg-2, line-2 border with a 2px bottom, 0x5 padding.  -->
    <Style x:Key="GaugeKbd" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource GaugeBg2Brush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource GaugeLine2Brush}" />
        <Setter Property="BorderThickness" Value="1,1,1,2" />
        <Setter Property="CornerRadius" Value="{StaticResource GaugeR3}" />
        <Setter Property="Padding" Value="5,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="GaugeKbdText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource GaugeMono}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{ThemeResource GaugeFg2Brush}" />
    </Style>

    <!--  Entity link: 12px mono fg-0 with an fg-3 underline; hover turns both accent.  -->
    <Style x:Key="GaugeEntityLink" TargetType="HyperlinkButton">
        <Setter Property="Foreground" Value="{ThemeResource GaugeFg0Brush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource GaugeFg3Brush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="FontFamily" Value="{StaticResource GaugeMono}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="FocusVisualMargin" Value="-3" />
        <Setter Property="FocusVisualPrimaryThickness" Value="2" />
        <Setter Property="FocusVisualSecondaryThickness" Value="0" />
        <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource GaugeAccentBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="HyperlinkButton">
                    <Grid x:Name="Root" Background="{TemplateBinding Background}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource GaugeAccentBrush}" />
                                        <Setter Target="Underline.Fill" Value="{ThemeResource GaugeAccentBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource GaugeAccentBrush}" />
                                        <Setter Target="Underline.Fill" Value="{ThemeResource GaugeAccentBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Opacity" Value="0.45" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <ContentPresenter
                            x:Name="ContentPresenter"
                            Padding="{TemplateBinding Padding}"
                            AutomationProperties.AccessibilityView="Raw"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Foreground="{TemplateBinding Foreground}" />
                        <!--  The underline is drawn, not a text decoration, so it can be its own colour.  -->
                        <Rectangle
                            x:Name="Underline"
                            Height="1"
                            Margin="0,0,0,1"
                            VerticalAlignment="Bottom"
                            Fill="{TemplateBinding BorderBrush}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Human-readable names (operators, profiles, files) read in 13px sans.  -->
    <Style
        x:Key="GaugeEntityLinkSans"
        BasedOn="{StaticResource GaugeEntityLink}"
        TargetType="HyperlinkButton">
        <Setter Property="FontFamily" Value="{StaticResource GaugeSans}" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <!-- ===================================================================================
         Layout: pane header, callout, status bar, navigation rail.
         ================================================================================= -->

    <!--  Pane header: 8x14 padding, line bottom border. Title + facts left, actions right.  -->
    <Style x:Key="GaugePaneHeader" TargetType="Border">
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="BorderBrush" Value="{ThemeResource GaugeLineBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="MinHeight" Value="42" />
    </Style>
    <Style x:Key="GaugePaneTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource GaugeFg0Brush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>
    <Style x:Key="GaugeFacts" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{ThemeResource GaugeFg2Brush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>
    <!--  A label beside a control in a header or toolbar ("Weigh by", "Theme").  -->
    <Style x:Key="GaugeInlineLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{ThemeResource GaugeFg2Brush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!--  Callout: 12x16 padding, bg-2, line-2 border. Crit variant for a blocking problem.  -->
    <Style x:Key="GaugeCallout" TargetType="Border">
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="Background" Value="{ThemeResource GaugeBg2Brush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource GaugeLine2Brush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource GaugeR2}" />
    </Style>
    <Style
        x:Key="GaugeCalloutCrit"
        BasedOn="{StaticResource GaugeCallout}"
        TargetType="Border">
        <Setter Property="BorderBrush" Value="{ThemeResource GaugeCritBrush}" />
    </Style>
    <Style x:Key="GaugeCalloutText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{ThemeResource GaugeFg1Brush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="18" />
    </Style>

    <!--  Status bar: 24px min, bg-2, line top border, 11.5px fg-2, 16px gaps.  -->
    <Style x:Key="GaugeStatusBar" TargetType="Border">
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="Padding" Value="12,1" />
        <Setter Property="Background" Value="{ThemeResource GaugeBg2Brush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource GaugeLineBrush}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
    </Style>
    <Style x:Key="GaugeStatusText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Foreground" Value="{ThemeResource GaugeFg2Brush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>

    <!--  Rail group label ("View", "Session plans"): 11.5px fg-2 600.  -->
    <Style x:Key="GaugeNavGroupLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource GaugeFg2Brush}" />
        <Setter Property="Margin" Value="9,10,9,4" />
    </Style>

    <!--
        Navigation item: 30px, 0x9 padding, r-3, fg-2. Hover bg-3 / fg-0; current
        (IsChecked) bg-4 / fg-0 / 600. A RadioButton so exactly one view is current.
    -->
    <Style x:Key="GaugeNavItem" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{ThemeResource GaugeFg2Brush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="9,0" />
        <Setter Property="Height" Value="30" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource GaugeR3}" />
        <Setter Property="FontFamily" Value="{StaticResource GaugeSans}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="FocusVisualMargin" Value="-2" />
        <Setter Property="FocusVisualPrimaryThickness" Value="2" />
        <Setter Property="FocusVisualSecondaryThickness" Value="0" />
        <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource GaugeAccentBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid
                        x:Name="Root"
                        Background="{TemplateBinding Background}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Hover.Opacity" Value="1" />
                                        <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource GaugeFg0Brush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Hover.Opacity" Value="1" />
                                        <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource GaugeFg0Brush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Opacity" Value="0.45" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="CheckStates">
                                <VisualState x:Name="Checked">
                                    <VisualState.Setters>
                                        <Setter Target="On.Opacity" Value="1" />
                                        <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource GaugeFg0Brush}" />
                                        <Setter Target="ContentPresenter.FontWeight" Value="SemiBold" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Unchecked" />
                                <VisualState x:Name="Indeterminate" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Border
                            x:Name="Hover"
                            Background="{ThemeResource GaugeBg3Brush}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Opacity="0" />
                        <Border
                            x:Name="On"
                            Background="{ThemeResource GaugeBg4Brush}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Opacity="0" />
                        <ContentPresenter
                            x:Name="ContentPresenter"
                            Padding="{TemplateBinding Padding}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                            AutomationProperties.AccessibilityView="Raw"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Foreground="{TemplateBinding Foreground}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        A selectable list row (data table, findings, session plans): transparent, hover bg-2.
        Selection is drawn by the row's own content (sel fill + 2px sel-edge) because it
        follows data, not pointer state.
    -->
    <Style x:Key="GaugeRowButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{ThemeResource GaugeFg1Brush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="FocusVisualMargin" Value="0" />
        <Setter Property="FocusVisualPrimaryThickness" Value="2" />
        <Setter Property="FocusVisualSecondaryThickness" Value="0" />
        <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource GaugeAccentBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root" Background="{TemplateBinding Background}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource GaugeBg2Brush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource GaugeBg3Brush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <ContentPresenter
                            x:Name="ContentPresenter"
                            Padding="{TemplateBinding Padding}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                            AutomationProperties.AccessibilityView="Raw"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Foreground="{TemplateBinding Foreground}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  A row in the navigation rail (session plans): r-3 corners, hover bg-3 on the bg-2 rail.  -->
    <Style x:Key="GaugeNavRowButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{ThemeResource GaugeFg1Brush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="9,5" />
        <Setter Property="CornerRadius" Value="{StaticResource GaugeR3}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="FocusVisualMargin" Value="-2" />
        <Setter Property="FocusVisualPrimaryThickness" Value="2" />
        <Setter Property="FocusVisualSecondaryThickness" Value="0" />
        <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource GaugeAccentBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid
                        x:Name="Root"
                        Background="{TemplateBinding Background}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource GaugeBg3Brush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource GaugeBg4Brush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <ContentPresenter
                            x:Name="ContentPresenter"
                            Padding="{TemplateBinding Padding}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                            AutomationProperties.AccessibilityView="Raw"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Foreground="{TemplateBinding Foreground}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Data table header cell text: 12px fg-2, weight 500, on a bg-2 header row.  -->
    <Style x:Key="GaugeTableHeaderText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{ThemeResource GaugeFg2Brush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!--  Stock keys point at Gauge so code and stock templates that name them follow along.  -->
    <Style
        x:Key="AccentButtonStyle"
        BasedOn="{StaticResource GaugePrimaryButton}"
        TargetType="Button" />
    <Style
        x:Key="DefaultButtonStyle"
        BasedOn="{StaticResource GaugeButton}"
        TargetType="Button" />
    <Style BasedOn="{StaticResource GaugeButton}" TargetType="Button" />
    <Style BasedOn="{StaticResource GaugeToggleButton}" TargetType="ToggleButton" />

</ResourceDictionary>
