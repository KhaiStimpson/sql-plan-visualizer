<UserControl
    x:Class="SqlPlanViz.Controls.CommandPalette"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Visibility="Collapsed">

    <!--
        The Ctrl+K command palette (docs/design/gauge/COMPONENTS.md, Command palette): a scrim,
        and a 600px bg-2 panel 70px from the top with a 15px input over a grouped list. Focus
        stays in the input; the active option is drawn as the selected record.
    -->
    <Grid>
        <Rectangle
            x:Name="Scrim"
            Fill="{ThemeResource GaugeScrimBrush}"
            Tapped="OnScrimTapped" />

        <Border
            x:Name="Panel"
            MaxWidth="600"
            Margin="12,70,12,12"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Top"
            Background="{ThemeResource GaugeBg2Brush}"
            BorderBrush="{ThemeResource GaugeLine2Brush}"
            BorderThickness="1"
            CornerRadius="{StaticResource GaugeRDialog}"
            Translation="0,0,32">
            <Border.Shadow>
                <ThemeShadow />
            </Border.Shadow>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBox
                    x:Name="Input"
                    Padding="16,14"
                    AutomationProperties.Name="Command palette: type a command or operator"
                    Background="Transparent"
                    BorderBrush="{ThemeResource GaugeLineBrush}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="6,6,0,0"
                    FontSize="15"
                    IsSpellCheckEnabled="False"
                    PlaceholderText="Type a command or operator"
                    PreviewKeyDown="OnInputKeyDown"
                    TextChanged="OnInputTextChanged">
                    <!--  The input sits flush in the panel: no fill and only a line divider below.  -->
                    <TextBox.Resources>
                        <ResourceDictionary>
                            <ResourceDictionary.ThemeDictionaries>
                                <ResourceDictionary x:Key="Default">
                                    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                                    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="{ThemeResource GaugeLine}" />
                                    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="{ThemeResource GaugeLine}" />
                                </ResourceDictionary>
                                <ResourceDictionary x:Key="Light">
                                    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                                    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="{ThemeResource GaugeLine}" />
                                    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="{ThemeResource GaugeLine}" />
                                </ResourceDictionary>
                            </ResourceDictionary.ThemeDictionaries>
                        </ResourceDictionary>
                    </TextBox.Resources>
                </TextBox>

                <ScrollViewer
                    x:Name="ListScroller"
                    Grid.Row="1"
                    MaxHeight="420"
                    IsTabStop="False"
                    VerticalScrollBarVisibility="Auto">
                    <StackPanel
                        x:Name="ListHost"
                        Padding="4,4,4,6"
                        AutomationProperties.Name="Commands" />
                </ScrollViewer>

                <!--  Announces the active option, since focus stays in the input.  -->
                <TextBlock
                    x:Name="Announcer"
                    Grid.Row="2"
                    Height="0"
                    AutomationProperties.LiveSetting="Polite"
                    Opacity="0" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
