<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="SqlPlanViz.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SqlPlanViz"
    xmlns:controls="using:SqlPlanViz.Controls">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!--  Gauge tokens (generated from docs/design/gauge/tokens.json). Merged after
                      the Fluent resources so its keys win on lookup.  -->
                <ResourceDictionary Source="ms-appx:///Themes/GaugeTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <local:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <local:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
            <local:SeverityToBrushConverter x:Key="SeverityToBrush" />
            <local:DivergenceForegroundConverter x:Key="DivergenceForeground" />
            <local:InverseBoolConverter x:Key="InverseBool" />
            <local:StringToVisibilityConverter x:Key="StringToVisibility" />
            <local:StringToDoubleConverter x:Key="StringToDouble" />
            <local:StringToBoolConverter x:Key="StringToBool" />
            <local:RowIndexToAlternateBrushConverter x:Key="RowIndexToAlternateBrush" />

            <!--  Gauge type: 13px sans for controls, 12px mono for code (DESIGN.md).  -->
            <FontFamily x:Key="ContentControlThemeFontFamily">Segoe UI Variable Text, Segoe UI Variable, Segoe UI</FontFamily>
            <x:Double x:Key="ControlContentThemeFontSize">13</x:Double>
            <x:Double x:Key="ContentControlFontSize">13</x:Double>

            <!--  A quiet bordered surface; Gauge prefers a pane header + rows over cards.  -->
            <Style x:Key="CardBorder" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource GaugeBg1Brush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource GaugeLineBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{StaticResource GaugeR3}" />
                <Setter Property="Padding" Value="12,10" />
            </Style>

            <!--  Group label inside a pane (the mock-up's "Why it matters" heading).  -->
            <Style x:Key="SectionHeader" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource GaugeFg2Brush}" />
                <Setter Property="Margin" Value="0,0,0,4" />
            </Style>

            <Style x:Key="FieldLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12.5" />
                <Setter Property="Foreground" Value="{ThemeResource GaugeFg2Brush}" />
            </Style>

            <Style x:Key="FieldValue" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Foreground" Value="{ThemeResource GaugeFg0Brush}" />
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="TextAlignment" Value="Right" />
            </Style>

            <Style x:Key="CodeText" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource GaugeMono}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{ThemeResource GaugeFg1Brush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="IsTextSelectionEnabled" Value="True" />
            </Style>

            <!--
                A thin centered grip so the splitter reads as draggable at rest, not a fully
                transparent 6px band (docs/editor-and-parameters-ux-plan.md Phase 4). The
                background stays transparent — the full 6px band is still the hit-test/drag
                target, only the grip paints.
            -->
            <Style TargetType="controls:PaneSplitter">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="controls:PaneSplitter">
                            <Grid Background="{TemplateBinding Background}">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="Grip.Fill" Value="{ThemeResource AccentFillColorDefaultBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="Grip.Fill" Value="{ThemeResource AccentFillColorTertiaryBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>

                                <Rectangle
                                    x:Name="Grip"
                                    Width="40"
                                    Height="3"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Fill="{ThemeResource ControlStrokeColorDefaultBrush}"
                                    RadiusX="1.5"
                                    RadiusY="1.5" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
