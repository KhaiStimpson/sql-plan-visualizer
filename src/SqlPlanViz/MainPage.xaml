<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SqlPlanViz.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:SqlPlanViz.Controls"
    xmlns:capture="using:SqlPlanViz.Capture"
    xmlns:diag="using:SqlPlanViz.Diagnostics"
    xmlns:model="using:SqlPlanViz.Model"
    xmlns:vm="using:SqlPlanViz.ViewModels"
    xmlns:views="using:SqlPlanViz.Views"
    mc:Ignorable="d">

    <Grid AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Title bar  -->
        <Grid x:Name="AppTitleBar" Height="44" Padding="14,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <FontIcon
                Grid.Column="0"
                VerticalAlignment="Center"
                FontFamily="Segoe Fluent Icons"
                FontSize="15"
                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                Glyph="&#xE9D9;" />
            <TextBlock
                Grid.Column="1"
                Margin="10,0,0,0"
                VerticalAlignment="Center"
                FontSize="12"
                FontWeight="SemiBold"
                Text="SQL Plan Visualizer" />
            <TextBlock
                Grid.Column="2"
                Margin="16,0,140,0"
                VerticalAlignment="Center"
                FontSize="12"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Text="{x:Bind ViewModel.SourceLabel, Mode=OneWay}"
                TextTrimming="CharacterEllipsis" />
        </Grid>

        <!--  Command strip  -->
        <Border
            Grid.Row="1"
            Padding="12,6"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,1">
            <Grid ColumnSpacing="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel
                    Grid.Column="0"
                    Orientation="Horizontal"
                    Spacing="4">
                    <Button Click="OnOpenFile" Style="{ThemeResource AccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon
                                FontFamily="Segoe Fluent Icons"
                                FontSize="14"
                                Glyph="&#xE8E5;" />
                            <TextBlock Text="Open plan" />
                        </StackPanel>
                    </Button>
                    <Button Click="OnPasteXml" ToolTipService.ToolTip="Paste Showplan XML">
                        <FontIcon
                            FontFamily="Segoe Fluent Icons"
                            FontSize="14"
                            Glyph="&#xE77F;" />
                    </Button>
                    <Button Click="OnConnect" ToolTipService.ToolTip="Run a query and capture its plan">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon
                                FontFamily="Segoe Fluent Icons"
                                FontSize="14"
                                Glyph="&#xE968;" />
                            <TextBlock Text="Capture" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <ComboBox
                    Grid.Column="1"
                    MaxWidth="260"
                    VerticalAlignment="Center"
                    ItemsSource="{x:Bind ViewModel.Statements, Mode=OneWay}"
                    SelectedItem="{x:Bind ViewModel.SelectedStatement, Mode=TwoWay}"
                    ToolTipService.ToolTip="Statement in this batch"
                    Visibility="{x:Bind ViewModel.HasMultipleStatements, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="model:PlanStatement">
                            <TextBlock Text="{x:Bind Summary.ShortText}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <StackPanel
                    Grid.Column="2"
                    HorizontalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="10"
                    Visibility="{x:Bind ViewModel.HasPlan, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <SelectorBar
                        x:Name="MetricSelector"
                        VerticalAlignment="Center"
                        SelectionChanged="OnMetricChanged">
                        <SelectorBarItem IsSelected="True" Text="Subtree cost" />
                        <SelectorBarItem Text="Operator cost" />
                        <SelectorBarItem
                            x:Name="RowsMetricItem"
                            Text="Actual rows" />
                        <SelectorBarItem
                            x:Name="TimeMetricItem"
                            Text="Elapsed time" />
                        <SelectorBarItem
                            x:Name="SelfTimeMetricItem"
                            Text="Self time" />
                        <SelectorBarItem
                            x:Name="EfficiencyMetricItem"
                            Text="Efficiency" />
                        <SelectorBarItem
                            x:Name="EstimateSkewMetricItem"
                            Text="Estimate skew" />
                    </SelectorBar>

                    <Button
                        x:Name="BlameToggleButton"
                        VerticalAlignment="Center"
                        Click="OnToggleColorMode"
                        Content="Blame"
                        ToolTipService.ToolTip="Colour nodes by finding severity instead of the selected metric" />

                    <Button
                        x:Name="VerbosityButton"
                        VerticalAlignment="Center"
                        Click="OnToggleVerbosity"
                        Content="Detailed"
                        ToolTipService.ToolTip="Toggle terse or expansive explanations" />

                    <AutoSuggestBox
                        x:Name="SearchBox"
                        Width="220"
                        VerticalAlignment="Center"
                        PlaceholderText="Search operators…"
                        QueryIcon="Find"
                        TextChanged="OnSearchChanged" />
                </StackPanel>

                <StackPanel
                    Grid.Column="3"
                    Orientation="Horizontal"
                    Spacing="2"
                    Visibility="{x:Bind ViewModel.HasPlan, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <Button
                        x:Name="PlaybackButton"
                        Click="OnTogglePlayback"
                        ToolTipService.ToolTip="Play operators in execution order">
                        <FontIcon
                            FontFamily="Segoe Fluent Icons"
                            FontSize="14"
                            Glyph="&#xE768;" />
                    </Button>
                    <Button
                        x:Name="OperatorListButton"
                        Click="OnToggleOperatorList"
                        ToolTipService.ToolTip="Toggle ranked operator list">
                        <FontIcon
                            FontFamily="Segoe Fluent Icons"
                            FontSize="14"
                            Glyph="&#xEA37;" />
                    </Button>
                    <Button
                        x:Name="CompareButton"
                        Click="OnCompareLatest"
                        Content="Compare"
                        IsEnabled="{x:Bind ViewModel.CanCompare, Mode=OneWay}"
                        ToolTipService.ToolTip="Compare the two latest session plans" />
                    <Button
                        Click="OnRerunAndCompare"
                        Content="Re-run"
                        IsEnabled="{x:Bind ViewModel.CanRerun, Mode=OneWay}"
                        ToolTipService.ToolTip="Re-run the last captured query and compare it with the prior plan" />
                    <Button
                        Click="OnToggleQueryStore"
                        Content="History"
                        IsEnabled="{x:Bind ViewModel.CanBrowseQueryStore, Mode=OneWay}"
                        ToolTipService.ToolTip="Browse Query Store plan history" />
                    <Button Click="OnToggleAntiPatterns" Content="Library" ToolTipService.ToolTip="Browse named plan anti-patterns" />
                    <Button
                        Content="Baseline"
                        IsEnabled="{x:Bind ViewModel.CanUseRegressionBaseline, Mode=OneWay}">
                        <Button.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Click="OnSaveRegressionBaseline" Text="Save baseline beside plan" />
                                <MenuFlyoutItem Click="OnCheckRegressionBaseline" Text="Check current plan" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                    <Button Click="OnZoomOut" ToolTipService.ToolTip="Zoom out">
                        <FontIcon
                            FontFamily="Segoe Fluent Icons"
                            FontSize="14"
                            Glyph="&#xE71F;" />
                    </Button>
                    <Button Click="OnZoomIn" ToolTipService.ToolTip="Zoom in">
                        <FontIcon
                            FontFamily="Segoe Fluent Icons"
                            FontSize="14"
                            Glyph="&#xE8A3;" />
                    </Button>
                    <Button Click="OnFit" ToolTipService.ToolTip="Fit plan to window">
                        <FontIcon
                            FontFamily="Segoe Fluent Icons"
                            FontSize="14"
                            Glyph="&#xE9A6;" />
                    </Button>
                    <Button ToolTipService.ToolTip="Collapse / expand subtrees">
                        <FontIcon
                            FontFamily="Segoe Fluent Icons"
                            FontSize="14"
                            Glyph="&#xE8A9;" />
                        <Button.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Click="OnCollapseCheap" Text="Auto-collapse cheap subtrees (&lt;2%)" />
                                <MenuFlyoutItem Click="OnFocusHotPath" Text="Focus the hot path" />
                                <MenuFlyoutItem Click="OnCollapseAll" Text="Collapse all subtrees" />
                                <MenuFlyoutItem Click="OnExpandAll" Text="Expand everything" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!--  Content  -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid x:Name="LeftContent" Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition x:Name="EditorPaneRow" Height="240" />
                </Grid.RowDefinitions>
                <controls:PlanCanvas
                    x:Name="Canvas"
                    Grid.Row="0"
                    FilterText="{x:Bind ViewModel.FilterText, Mode=OneWay}"
                    ExplanationVerbosity="{x:Bind ViewModel.ExplanationVerbosity, Mode=OneWay}"
                    LayoutChanged="OnCanvasLayoutChanged"
                    Metric="{x:Bind ViewModel.Metric, Mode=OneWay}"
                    SelectedNode="{x:Bind ViewModel.SelectedNode, Mode=TwoWay}"
                    Statement="{x:Bind ViewModel.SelectedStatement, Mode=OneWay}" />

                <Button
                    x:Name="FocusBreadcrumbButton"
                    Grid.Row="0"
                    Margin="14"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Click="OnExitFocus"
                    Visibility="Collapsed" />

                <Border
                    x:Name="OperatorListPane"
                    Grid.Row="0"
                    Margin="14"
                    Padding="12"
                    Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Visibility="Collapsed">
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <TextBlock
                                FontSize="16"
                                FontWeight="SemiBold"
                                Text="Operators ranked by self time" />
                            <Button
                                HorizontalAlignment="Right"
                                Click="OnToggleOperatorList"
                                Content="Back to tree" />
                        </Grid>
                        <ListView
                            Grid.Row="1"
                            ItemsSource="{x:Bind ViewModel.RankedOperators, Mode=OneWay}">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:OperatorRankItem">
                                    <Button
                                        Margin="0,0,0,4"
                                        Padding="10,8"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Click="OnJumpToRankedOperator"
                                        Tag="{x:Bind Node}">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="42" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                FontSize="14"
                                                FontWeight="SemiBold"
                                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                Text="{x:Bind RankText}" />
                                            <StackPanel Grid.Column="1" Spacing="2">
                                                <TextBlock FontWeight="SemiBold" Text="{x:Bind Title}" />
                                                <TextBlock
                                                    FontSize="11"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Text="{x:Bind Subtitle}"
                                                    TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                                <TextBlock HorizontalAlignment="Right" Text="{x:Bind PrimaryMetric}" />
                                                <TextBlock
                                                    HorizontalAlignment="Right"
                                                    FontSize="11"
                                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                    Text="{x:Bind RowsText}" />
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>

                <Border
                    x:Name="QueryStorePane"
                    Grid.Row="0"
                    Margin="14"
                    Padding="12"
                    Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Visibility="Collapsed">
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <TextBlock FontSize="16" FontWeight="SemiBold" Text="Query Store plan history" />
                            <Button HorizontalAlignment="Right" Click="OnToggleQueryStore" Content="Back to tree" />
                        </Grid>
                        <Grid Grid.Row="1">
                            <ProgressRing IsActive="{x:Bind ViewModel.IsLoadingQueryStore, Mode=OneWay}" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind ViewModel.QueryStoreMessage, Mode=OneWay}"
                                TextWrapping="Wrap" />
                            <ListView ItemsSource="{x:Bind ViewModel.QueryStorePlans, Mode=OneWay}">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="capture:QueryStorePlanEntry">
                                        <Button
                                            Margin="0,0,0,4"
                                            Padding="10,8"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Click="OnOpenQueryStorePlan"
                                            Tag="{x:Bind}">
                                            <StackPanel Spacing="2">
                                                <TextBlock FontWeight="SemiBold" Text="{x:Bind Title}" TextWrapping="Wrap" />
                                                <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind Detail}" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Grid>
                </Border>

                <Border
                    x:Name="AntiPatternPane"
                    Grid.Row="0"
                    Margin="14"
                    Padding="12"
                    Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Visibility="Collapsed">
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <TextBlock FontSize="16" FontWeight="SemiBold" Text="Plan anti-pattern library" />
                            <Button HorizontalAlignment="Right" Click="OnToggleAntiPatterns" Content="Back to tree" />
                        </Grid>
                        <ScrollViewer Grid.Row="1">
                            <ItemsControl ItemsSource="{x:Bind AntiPatterns}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="diag:AntiPatternInfo">
                                        <Expander Margin="0,0,0,8" Header="{x:Bind Name}">
                                            <StackPanel Padding="0,8,0,4" Spacing="6">
                                                <TextBlock FontWeight="SemiBold" Text="{x:Bind Summary}" TextWrapping="Wrap" />
                                                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind Explanation}" TextWrapping="Wrap" />
                                                <TextBlock FontFamily="Cascadia Mono, Consolas" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="{x:Bind RuleId}" />
                                            </StackPanel>
                                        </Expander>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!--  Empty state  -->
                <StackPanel
                    Grid.Row="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MaxWidth="460"
                    Spacing="14"
                    Visibility="{x:Bind ViewModel.HasNoPlan, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <FontIcon
                        FontFamily="Segoe Fluent Icons"
                        FontSize="42"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Glyph="&#xE9D9;" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="19"
                        FontWeight="SemiBold"
                        Text="No plan loaded" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextAlignment="Center"
                        TextWrapping="Wrap"
                        Text="Drop a .sqlplan file here, open one, paste Showplan XML, or capture a plan straight from a live SQL Server connection." />
                    <StackPanel
                        HorizontalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="8">
                        <Button Click="OnOpenFile" Style="{ThemeResource AccentButtonStyle}" Content="Open a .sqlplan file" />
                        <Button Click="OnPasteXml" Content="Paste XML" />
                        <Button Click="OnConnect" Content="Capture from server" />
                    </StackPanel>
                </StackPanel>

                <!--  Error  -->
                <InfoBar
                    Grid.Row="0"
                    Margin="16"
                    VerticalAlignment="Top"
                    CloseButtonClick="OnDismissError"
                    IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                    Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                    Severity="Error"
                    Title="Could not load that plan" />

                <!--  Busy  -->
                <Grid
                    Grid.Row="0"
                    Background="{ThemeResource SmokeFillColorDefaultBrush}"
                    Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="16">
                        <ProgressRing
                            Width="44"
                            Height="44"
                            IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            Text="{x:Bind ViewModel.BusyMessage, Mode=OneWay}" />
                    </StackPanel>
                </Grid>

                <!--
                    The editor pane (docs/live-plan-editor-plan.md). The read-only SQL strip
                    it replaces could only ever show you the SQL; this can change it, compile
                    it, and say whether the change helped.
                -->
                <controls:PaneSplitter
                    x:Name="EditorSplitter"
                    Grid.Row="1"
                    Visibility="{x:Bind ViewModel.HasPlan, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />

                <Border
                    x:Name="EditorPane"
                    Grid.Row="2"
                    Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="0,1,0,0"
                    Visibility="{x:Bind ViewModel.HasPlan, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!--  Editor toolbar  -->
                        <Grid
                            Grid.Row="0"
                            Padding="10,5"
                            ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                x:Name="SqlMappingLabel"
                                VerticalAlignment="Center"
                                FontSize="11"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="SQL · select an operator to highlight its likely clause" />

                            <TextBlock
                                x:Name="EditorStatusText"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                FontSize="11"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                TextTrimming="CharacterEllipsis" />

                            <StackPanel
                                Grid.Column="2"
                                Orientation="Horizontal"
                                Spacing="4">
                                <ProgressRing
                                    x:Name="EditorBusyRing"
                                    Width="16"
                                    Height="16"
                                    VerticalAlignment="Center"
                                    IsActive="{x:Bind ViewModel.Editor.IsBusy, Mode=OneWay}"
                                    Visibility="{x:Bind ViewModel.Editor.IsBusy, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                <Button
                                    Padding="10,4"
                                    Click="OnCopySql"
                                    ToolTipService.ToolTip="Copy the statement">
                                    <FontIcon
                                        FontFamily="Segoe Fluent Icons"
                                        FontSize="12"
                                        Glyph="&#xE8C8;" />
                                </Button>
                                <Button
                                    x:Name="CancelReplanButton"
                                    Padding="8,2"
                                    Click="OnCancelReplan"
                                    Content="Cancel"
                                    FontSize="11"
                                    Visibility="{x:Bind ViewModel.Editor.IsBusy, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                <Button
                                    x:Name="ReplanButton"
                                    Padding="10,2"
                                    Click="OnReplan"
                                    FontSize="11"
                                    Style="{ThemeResource AccentButtonStyle}"
                                    ToolTipService.ToolTip="Compile the edited batch and swap in its plan (Ctrl+Enter)">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon
                                            FontFamily="Segoe Fluent Icons"
                                            FontSize="12"
                                            Glyph="&#xE768;" />
                                        <TextBlock Text="Re-plan" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <controls:SqlEditorControl x:Name="SqlEditor" Grid.Row="1" />

                        <views:ParameterStrip x:Name="Parameters" Grid.Row="2" />
                    </Grid>
                </Border>
            </Grid>

            <!--  Detail pane  -->
            <Border
                Grid.Column="1"
                Width="400"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="1,0,0,0"
                Visibility="{x:Bind ViewModel.HasPlan, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border
                        Grid.Row="0"
                        Margin="12,12,12,0"
                        Padding="12,10"
                        Background="{ThemeResource LayerFillColorAltBrush}"
                        CornerRadius="8">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                FontSize="12"
                                IsTextSelectionEnabled="True"
                                Text="{x:Bind ViewModel.Narrative, Mode=OneWay}"
                                TextWrapping="Wrap" />
                            <Button
                                Grid.Column="1"
                                VerticalAlignment="Top"
                                Click="OnCopyDiagnosis"
                                ToolTipService.ToolTip="Copy diagnosis as Markdown">
                                <FontIcon
                                    FontFamily="Segoe Fluent Icons"
                                    FontSize="13"
                                    Glyph="&#xE8C8;" />
                            </Button>
                        </Grid>
                    </Border>

                    <SelectorBar
                        x:Name="PaneSelector"
                        Grid.Row="1"
                        Margin="10,10,10,4"
                        SelectionChanged="OnPaneChanged">
                        <SelectorBarItem x:Name="FindingsTab" IsSelected="True" Text="Findings" />
                        <SelectorBarItem Text="Operator" />
                        <SelectorBarItem x:Name="IndexesTab" Text="Indexes" />
                        <SelectorBarItem x:Name="WarningsTab" Text="Warnings" />
                        <SelectorBarItem x:Name="DeltaTab" Text="Delta" />
                    </SelectorBar>

                    <!--  Ranked diagnostic findings  -->
                    <ScrollViewer
                        x:Name="FindingsPane"
                        Grid.Row="2"
                        Padding="12,8,12,16">
                        <StackPanel Spacing="8">
                            <TextBlock
                                Margin="4,24,4,0"
                                HorizontalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                TextAlignment="Center"
                                TextWrapping="Wrap"
                                Text="No diagnostic findings for the available plan data."
                                Visibility="{x:Bind ViewModel.HasFindings, Mode=OneWay, Converter={StaticResource InverseBoolToVisibility}}" />

                            <ItemsControl ItemsSource="{x:Bind ViewModel.Findings, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:FindingItem">
                                        <Border Margin="0,0,0,10" Style="{StaticResource CardBorder}">
                                            <StackPanel Spacing="8">
                                                <Button
                                                    Padding="0"
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Stretch"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Click="OnJumpToFinding"
                                                    Tag="{x:Bind PrimaryNode}">
                                                    <Grid ColumnSpacing="9">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border
                                                            Width="30"
                                                            Height="30"
                                                            VerticalAlignment="Top"
                                                            Background="{Binding Severity, Converter={StaticResource SeverityToBrush}}"
                                                            CornerRadius="15">
                                                            <FontIcon
                                                                FontFamily="Segoe Fluent Icons"
                                                                FontSize="13"
                                                                Foreground="White"
                                                                Glyph="{x:Bind SeverityGlyph}" />
                                                        </Border>
                                                        <StackPanel Grid.Column="1" Spacing="3">
                                                            <TextBlock
                                                                FontSize="13"
                                                                FontWeight="SemiBold"
                                                                Text="{x:Bind Title}"
                                                                TextWrapping="Wrap" />
                                                            <TextBlock
                                                                FontSize="11"
                                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                Text="{x:Bind Location}" />
                                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                                <TextBlock
                                                                    FontSize="11"
                                                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                                    Text="{x:Bind ImpactText}" />
                                                                <TextBlock
                                                                    FontSize="11"
                                                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                                    Text="{x:Bind ConfidenceText}" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Grid>
                                                </Button>

                                                <Expander HorizontalAlignment="Stretch" Header="Why and fixes">
                                                    <StackPanel Padding="0,8,0,0" Spacing="10">
                                                        <TextBlock
                                                            FontSize="12"
                                                            IsTextSelectionEnabled="True"
                                                            Text="{x:Bind Why}"
                                                            TextWrapping="Wrap" />

                                                        <Border
                                                            Padding="10,8"
                                                            Background="{ThemeResource AccentFillColorSecondaryBrush}"
                                                            CornerRadius="6"
                                                            Visibility="{x:Bind HasWhatIf, Converter={StaticResource BoolToVisibility}}">
                                                            <StackPanel Spacing="3">
                                                                <TextBlock FontSize="11" FontWeight="SemiBold" Text="APPROXIMATE WHAT-IF" />
                                                                <TextBlock FontSize="12" Text="{x:Bind WhatIf.Summary}" TextWrapping="Wrap" />
                                                                <TextBlock FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="Directional estimate only; re-run the query to measure the real result." TextWrapping="Wrap" />
                                                            </StackPanel>
                                                        </Border>

                                                        <StackPanel Spacing="5">
                                                            <TextBlock FontSize="11" FontWeight="SemiBold" Text="{x:Bind TriageText, Mode=OneWay}" />
                                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                                <Button Click="OnTriageTried" Content="Tried" IsEnabled="{x:Bind CanPersist}" Tag="{x:Bind}" />
                                                                <Button Click="OnTriageDidNotHelp" Content="No help" IsEnabled="{x:Bind CanPersist}" Tag="{x:Bind}" />
                                                                <Button Click="OnTriageFixed" Content="Fixed" IsEnabled="{x:Bind CanPersist}" Tag="{x:Bind}" />
                                                                <Button Click="OnTriageReset" Content="Reset" IsEnabled="{x:Bind CanPersist}" Tag="{x:Bind}" />
                                                            </StackPanel>
                                                            <TextBlock FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="Triage is saved beside file-backed plans." />
                                                        </StackPanel>

                                                        <ItemsControl ItemsSource="{x:Bind Fixes}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="vm:FindingFixItem">
                                                                    <Border
                                                                        Margin="0,0,0,8"
                                                                        Padding="10,8"
                                                                        Background="{ThemeResource LayerFillColorAltBrush}"
                                                                        CornerRadius="6">
                                                                        <StackPanel Spacing="5">
                                                                            <TextBlock
                                                                                FontSize="11"
                                                                                FontWeight="SemiBold"
                                                                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                                                Text="{x:Bind Kind}" />
                                                                            <TextBlock
                                                                                FontSize="12"
                                                                                Text="{x:Bind Summary}"
                                                                                TextWrapping="Wrap" />
                                                                            <TextBlock
                                                                                Style="{StaticResource CodeText}"
                                                                                Text="{x:Bind Snippet}"
                                                                                Visibility="{x:Bind HasSnippet, Converter={StaticResource BoolToVisibility}}" />
                                                                            <TextBlock
                                                                                FontSize="11"
                                                                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                                                Text="{x:Bind Caveat}"
                                                                                TextWrapping="Wrap"
                                                                                Visibility="{x:Bind HasCaveat, Converter={StaticResource BoolToVisibility}}" />
                                                                        </StackPanel>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </Expander>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <!--  Operator detail  -->
                    <ScrollViewer
                        x:Name="OperatorPane"
                        Grid.Row="2"
                        Padding="12,8,12,16"
                        Visibility="Collapsed">
                        <StackPanel Spacing="10">
                            <TextBlock
                                Margin="4,24,4,0"
                                HorizontalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                TextAlignment="Center"
                                TextWrapping="Wrap"
                                Text="Select an operator in the plan to see its rows, cost and predicates."
                                Visibility="{x:Bind ViewModel.HasNoSelection, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />

                            <StackPanel
                                Spacing="10"
                                Visibility="{x:Bind ViewModel.HasSelection, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">

                                <!--  Header  -->
                                <StackPanel Spacing="2">
                                    <TextBlock
                                        FontSize="19"
                                        FontWeight="SemiBold"
                                        Text="{x:Bind ViewModel.SelectedDetail.Title, Mode=OneWay}"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind ViewModel.SelectedDetail.Subtitle, Mode=OneWay}" />
                                    <TextBlock
                                        Margin="0,4,0,0"
                                        FontFamily="Cascadia Mono, Consolas"
                                        FontSize="12"
                                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                        IsTextSelectionEnabled="True"
                                        Text="{x:Bind ViewModel.SelectedDetail.ObjectName, Mode=OneWay}"
                                        TextWrapping="Wrap"
                                        Visibility="{x:Bind ViewModel.SelectedDetail.HasObject, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>

                                <Expander Header="Annotation">
                                    <StackPanel Padding="0,8,0,0" Spacing="7">
                                        <TextBox
                                            AcceptsReturn="True"
                                            MinHeight="72"
                                            PlaceholderText="Add a note about this operator…"
                                            Text="{x:Bind ViewModel.SelectedAnnotation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            TextWrapping="Wrap" />
                                        <Grid>
                                            <TextBlock
                                                Margin="0,0,90,0"
                                                VerticalAlignment="Center"
                                                FontSize="11"
                                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                Text="{x:Bind ViewModel.AnnotationHint, Mode=OneWay}"
                                                TextWrapping="Wrap" />
                                            <Button
                                                HorizontalAlignment="Right"
                                                Click="OnSaveAnnotation"
                                                Content="Save note"
                                                IsEnabled="{x:Bind ViewModel.CanAnnotate, Mode=OneWay}" />
                                        </Grid>
                                    </StackPanel>
                                </Expander>

                                <Expander Header="Live object context">
                                    <StackPanel Padding="0,8,0,0" Spacing="8">
                                        <ProgressRing
                                            HorizontalAlignment="Left"
                                            IsActive="{x:Bind ViewModel.IsLoadingObjectContext, Mode=OneWay}"
                                            Visibility="{x:Bind ViewModel.IsLoadingObjectContext, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{x:Bind ViewModel.ObjectContextMessage, Mode=OneWay}"
                                            TextWrapping="Wrap"
                                            Visibility="{x:Bind ViewModel.HasNoObjectContext, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                        <StackPanel
                                            Spacing="8"
                                            Visibility="{x:Bind ViewModel.HasObjectContext, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock FontWeight="SemiBold" Text="{x:Bind ViewModel.SelectedObjectContext.DisplayName, Mode=OneWay}" />
                                            <TextBlock Text="{x:Bind ViewModel.SelectedObjectContext.RowCountText, Mode=OneWay}" />
                                            <TextBlock Text="{x:Bind ViewModel.SelectedObjectContext.SizeText, Mode=OneWay}" />
                                            <TextBlock Style="{StaticResource SectionHeader}" Text="INDEXES" />
                                            <ItemsControl ItemsSource="{x:Bind ViewModel.SelectedObjectContext.Indexes, Mode=OneWay}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="capture:DatabaseIndexInfo">
                                                        <StackPanel Margin="0,0,0,6">
                                                            <TextBlock FontWeight="SemiBold" Text="{x:Bind Name}" />
                                                            <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind Kind}" />
                                                            <TextBlock FontSize="11" Text="{x:Bind ColumnSummary}" TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Style="{StaticResource SectionHeader}" Text="STATISTICS" />
                                            <ItemsControl ItemsSource="{x:Bind ViewModel.SelectedObjectContext.Statistics, Mode=OneWay}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="capture:DatabaseStatisticInfo">
                                                        <StackPanel Margin="0,0,0,6">
                                                            <TextBlock FontWeight="SemiBold" Text="{x:Bind Name}" />
                                                            <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind Detail}" TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </StackPanel>
                                </Expander>

                                <!--  Rows: estimated vs actual  -->
                                <Border Style="{StaticResource CardBorder}">
                                    <StackPanel Spacing="8">
                                        <TextBlock Style="{StaticResource SectionHeader}" Text="ROWS" />

                                        <TextBlock
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{x:Bind ViewModel.SelectedDetail.EstimateVerdict, Mode=OneWay}"
                                            TextWrapping="Wrap" />

                                        <Grid ColumnSpacing="10" RowSpacing="4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="62" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <TextBlock
                                                Grid.Row="0"
                                                Grid.Column="0"
                                                Style="{StaticResource FieldLabel}"
                                                Text="Estimated" />
                                            <ProgressBar
                                                Grid.Row="0"
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Maximum="100"
                                                Value="{x:Bind ViewModel.SelectedDetail.EstimatedBar, Mode=OneWay}" />
                                            <TextBlock
                                                Grid.Row="0"
                                                Grid.Column="2"
                                                Style="{StaticResource FieldValue}"
                                                Text="{x:Bind ViewModel.SelectedDetail.EstimatedRowsText, Mode=OneWay}" />

                                            <TextBlock
                                                Grid.Row="1"
                                                Grid.Column="0"
                                                Style="{StaticResource FieldLabel}"
                                                Text="Actual" />
                                            <ProgressBar
                                                Grid.Row="1"
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                                Maximum="100"
                                                Value="{x:Bind ViewModel.SelectedDetail.ActualBar, Mode=OneWay}" />
                                            <TextBlock
                                                Grid.Row="1"
                                                Grid.Column="2"
                                                Style="{StaticResource FieldValue}"
                                                Text="{x:Bind ViewModel.SelectedDetail.ActualRowsText, Mode=OneWay}" />
                                        </Grid>

                                        <TextBlock
                                            FontSize="11"
                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                            Text="{x:Bind ViewModel.SelectedDetail.EstimatePerExecutionNote, Mode=OneWay}"
                                            TextWrapping="Wrap"
                                            Visibility="{x:Bind ViewModel.SelectedDetail.HasEstimatePerExecutionNote, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                </Border>

                                <!--  Cost  -->
                                <Border Style="{StaticResource CardBorder}">
                                    <StackPanel Spacing="6">
                                        <TextBlock Style="{StaticResource SectionHeader}" Text="COST" />
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="Subtree" />
                                            <TextBlock
                                                Grid.Column="1"
                                                Style="{StaticResource FieldValue}"
                                                Text="{x:Bind ViewModel.SelectedDetail.SubtreeCostText, Mode=OneWay}" />
                                        </Grid>
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="This operator" />
                                            <TextBlock
                                                Grid.Column="1"
                                                Style="{StaticResource FieldValue}"
                                                Text="{x:Bind ViewModel.SelectedDetail.OperatorCostText, Mode=OneWay}" />
                                        </Grid>
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="Share of statement" />
                                            <TextBlock
                                                Grid.Column="1"
                                                Style="{StaticResource FieldValue}"
                                                Text="{x:Bind ViewModel.SelectedDetail.CostShareText, Mode=OneWay}" />
                                        </Grid>

                                        <TextBlock
                                            Margin="0,6,0,0"
                                            FontSize="11"
                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                            Text="CPU vs I/O" />
                                        <Grid ColumnSpacing="6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="28" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="CPU" />
                                            <ProgressBar
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Maximum="100"
                                                Value="{x:Bind ViewModel.SelectedDetail.CpuBar, Mode=OneWay}" />
                                            <TextBlock
                                                Grid.Column="2"
                                                Style="{StaticResource FieldValue}"
                                                Text="{x:Bind ViewModel.SelectedDetail.CpuCostText, Mode=OneWay}" />
                                        </Grid>
                                        <Grid ColumnSpacing="6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="28" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="I/O" />
                                            <ProgressBar
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Maximum="100"
                                                Value="{x:Bind ViewModel.SelectedDetail.IoBar, Mode=OneWay}" />
                                            <TextBlock
                                                Grid.Column="2"
                                                Style="{StaticResource FieldValue}"
                                                Text="{x:Bind ViewModel.SelectedDetail.IoCostText, Mode=OneWay}" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!--  Timing  -->
                                <Border
                                    Style="{StaticResource CardBorder}"
                                    Visibility="{x:Bind ViewModel.SelectedDetail.HasTiming, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel Spacing="6">
                                        <TextBlock Style="{StaticResource SectionHeader}" Text="TIMING" />
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="Elapsed (slowest thread)" />
                                            <TextBlock
                                                Grid.Column="1"
                                                Style="{StaticResource FieldValue}"
                                                Text="{x:Bind ViewModel.SelectedDetail.ElapsedText, Mode=OneWay}" />
                                        </Grid>
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="CPU (all threads)" />
                                            <TextBlock
                                                Grid.Column="1"
                                                Style="{StaticResource FieldValue}"
                                                Text="{x:Bind ViewModel.SelectedDetail.ActualCpuText, Mode=OneWay}" />
                                        </Grid>
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="Executions" />
                                            <TextBlock
                                                Grid.Column="1"
                                                Style="{StaticResource FieldValue}"
                                                Text="{x:Bind ViewModel.SelectedDetail.ExecutionsText, Mode=OneWay}" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!--  Predicates  -->
                                <Border
                                    Style="{StaticResource CardBorder}"
                                    Visibility="{x:Bind ViewModel.SelectedDetail.HasSeekPredicate, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel Spacing="6">
                                        <TextBlock Style="{StaticResource SectionHeader}" Text="SEEK PREDICATE" />
                                        <TextBlock Style="{StaticResource CodeText}" Text="{x:Bind ViewModel.SelectedDetail.SeekPredicate, Mode=OneWay}" />
                                    </StackPanel>
                                </Border>

                                <Border
                                    Style="{StaticResource CardBorder}"
                                    Visibility="{x:Bind ViewModel.SelectedDetail.HasPredicate, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel Spacing="6">
                                        <TextBlock Style="{StaticResource SectionHeader}" Text="PREDICATE" />
                                        <TextBlock Style="{StaticResource CodeText}" Text="{x:Bind ViewModel.SelectedDetail.Predicate, Mode=OneWay}" />
                                    </StackPanel>
                                </Border>

                                <!--  Warnings on this operator  -->
                                <ItemsControl
                                    ItemsSource="{x:Bind ViewModel.SelectedDetail.Warnings, Mode=OneWay}"
                                    Visibility="{x:Bind ViewModel.SelectedDetail.HasWarnings, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:WarningItem">
                                            <Border
                                                Margin="0,0,0,8"
                                                Style="{StaticResource CardBorder}">
                                                <StackPanel Orientation="Horizontal" Spacing="10">
                                                    <FontIcon
                                                        VerticalAlignment="Top"
                                                        FontFamily="Segoe Fluent Icons"
                                                        FontSize="15"
                                                        Foreground="{Binding Severity, Converter={StaticResource SeverityToBrush}}"
                                                        Glyph="{x:Bind SeverityGlyph}" />
                                                    <StackPanel Spacing="2">
                                                        <TextBlock
                                                            FontSize="13"
                                                            FontWeight="SemiBold"
                                                            Text="{x:Bind Title}"
                                                            TextWrapping="Wrap" />
                                                        <TextBlock
                                                            FontSize="12"
                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                            Text="{x:Bind Detail}"
                                                            TextWrapping="Wrap"
                                                            Visibility="{x:Bind HasDetail, Converter={StaticResource BoolToVisibility}}" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!--  Output list  -->
                                <Expander
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    Header="{x:Bind ViewModel.SelectedDetail.OutputListHeader, Mode=OneWay}"
                                    Visibility="{x:Bind ViewModel.SelectedDetail.HasOutputList, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                    <ItemsControl ItemsSource="{x:Bind ViewModel.SelectedDetail.OutputList, Mode=OneWay}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <TextBlock
                                                    FontFamily="Cascadia Mono, Consolas"
                                                    FontSize="12"
                                                    IsTextSelectionEnabled="True"
                                                    Text="{x:Bind}"
                                                    TextWrapping="Wrap" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Expander>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!--  Missing indexes  -->
                    <ScrollViewer
                        x:Name="IndexesPane"
                        Grid.Row="2"
                        Padding="12,8,12,16"
                        Visibility="Collapsed">
                        <StackPanel Spacing="10">
                            <TextBlock
                                Margin="4,24,4,0"
                                HorizontalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                TextAlignment="Center"
                                TextWrapping="Wrap"
                                Text="This plan carries no missing-index suggestions."
                                Visibility="{x:Bind ViewModel.HasMissingIndexes, Mode=OneWay, Converter={StaticResource InverseBoolToVisibility}}" />

                            <ItemsControl ItemsSource="{x:Bind ViewModel.MissingIndexes, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:IndexSuggestionItem">
                                        <Border Margin="0,0,0,10" Style="{StaticResource CardBorder}">
                                            <StackPanel Spacing="8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock
                                                        FontSize="14"
                                                        FontWeight="SemiBold"
                                                        Text="{x:Bind DisplayTarget}"
                                                        TextWrapping="Wrap" />
                                                    <Border
                                                        Grid.Column="1"
                                                        Padding="8,2"
                                                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                        CornerRadius="10">
                                                        <TextBlock
                                                            FontSize="11"
                                                            FontWeight="SemiBold"
                                                            Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                                            Text="{x:Bind ImpactText}" />
                                                    </Border>
                                                </Grid>

                                                <TextBlock
                                                    FontSize="12"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Text="{x:Bind ColumnSummary}"
                                                    TextWrapping="Wrap" />

                                                <TextBlock
                                                    FontSize="11"
                                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                    Text="{x:Bind VerificationText, Mode=OneWay}"
                                                    TextWrapping="Wrap" />

                                                <Border
                                                    Padding="10,8"
                                                    Background="{ThemeResource LayerFillColorAltBrush}"
                                                    CornerRadius="6"
                                                    Visibility="{x:Bind CanShowScript, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock Style="{StaticResource CodeText}" Text="{x:Bind SuggestedCreateStatement}" />
                                                </Border>

                                                <TextBlock
                                                    FontSize="11"
                                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                    Text="{x:Bind Caveat}"
                                                    TextWrapping="Wrap"
                                                    Visibility="{x:Bind CanShowScript, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />

                                                <Button
                                                    HorizontalAlignment="Right"
                                                    Click="OnCopyIndexScript"
                                                    Tag="{x:Bind SuggestedCreateStatement}"
                                                    Visibility="{x:Bind CanShowScript, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <FontIcon
                                                            FontFamily="Segoe Fluent Icons"
                                                            FontSize="13"
                                                            Glyph="&#xE8C8;" />
                                                        <TextBlock Text="Copy" />
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <!--  Warnings  -->
                    <ScrollViewer
                        x:Name="WarningsPane"
                        Grid.Row="2"
                        Padding="12,8,12,16"
                        Visibility="Collapsed">
                        <StackPanel Spacing="8">
                            <TextBlock
                                Margin="4,24,4,0"
                                HorizontalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                TextAlignment="Center"
                                TextWrapping="Wrap"
                                Text="No warnings in this plan."
                                Visibility="{x:Bind ViewModel.HasWarnings, Mode=OneWay, Converter={StaticResource InverseBoolToVisibility}}" />

                            <ItemsControl ItemsSource="{x:Bind ViewModel.Warnings, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:WarningItem">
                                        <Button
                                            Margin="0,0,0,8"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Click="OnJumpToWarning"
                                            Tag="{x:Bind Node}">
                                            <Border Style="{StaticResource CardBorder}">
                                                <StackPanel Orientation="Horizontal" Spacing="10">
                                                    <FontIcon
                                                        VerticalAlignment="Top"
                                                        FontFamily="Segoe Fluent Icons"
                                                        FontSize="15"
                                                        Foreground="{Binding Severity, Converter={StaticResource SeverityToBrush}}"
                                                        Glyph="{x:Bind SeverityGlyph}" />
                                                    <StackPanel Spacing="2">
                                                        <TextBlock
                                                            FontSize="13"
                                                            FontWeight="SemiBold"
                                                            Text="{x:Bind Title}"
                                                            TextWrapping="Wrap" />
                                                        <TextBlock
                                                            FontSize="12"
                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                            Text="{x:Bind Location}" />
                                                        <TextBlock
                                                            FontSize="12"
                                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                            Text="{x:Bind Detail}"
                                                            TextWrapping="Wrap"
                                                            Visibility="{x:Bind HasDetail, Converter={StaticResource BoolToVisibility}}" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <!--  Plan comparison metric deltas  -->
                    <ScrollViewer
                        x:Name="DeltaPane"
                        Grid.Row="2"
                        Padding="12,8,12,16"
                        Visibility="Collapsed">
                        <StackPanel Spacing="8">
                            <ComboBox
                                HorizontalAlignment="Stretch"
                                Header="Sort by"
                                SelectedIndex="0"
                                SelectionChanged="OnDeltaSortChanged">
                                <ComboBoxItem Content="Largest cost regression" />
                                <ComboBoxItem Content="Largest row change" />
                                <ComboBoxItem Content="Change type" />
                                <ComboBoxItem Content="Operator name" />
                            </ComboBox>
                            <TextBlock
                                Margin="4,24,4,0"
                                HorizontalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Text="Compare the two latest session plans to see metric deltas."
                                TextAlignment="Center"
                                TextWrapping="Wrap"
                                Visibility="{x:Bind ViewModel.HasDiff, Mode=OneWay, Converter={StaticResource InverseBoolToVisibility}}" />
                            <ListView ItemsSource="{x:Bind ViewModel.DiffDeltas, Mode=OneWay}">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:PlanDeltaItem">
                                        <Button
                                            Padding="8"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Click="OnJumpToDelta"
                                            Tag="{x:Bind TargetNode}">
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="64" />
                                                    <ColumnDefinition Width="70" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock FontWeight="SemiBold" Text="{x:Bind Operator}" />
                                                    <TextBlock
                                                        FontSize="10"
                                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                        Text="{x:Bind ObjectName}"
                                                        TextTrimming="CharacterEllipsis" />
                                                    <TextBlock
                                                        FontSize="10"
                                                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                        Text="{x:Bind Change}" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" HorizontalAlignment="Right" Text="{x:Bind CostDeltaText}" />
                                                <TextBlock Grid.Column="2" HorizontalAlignment="Right" Text="{x:Bind RowsDeltaText}" />
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!--  In-memory session capture strip  -->
        <Border
            Grid.Row="3"
            Padding="10,6"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0"
            Visibility="{x:Bind ViewModel.HasSessionPlans, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Enabled">
                <ItemsControl ItemsSource="{x:Bind ViewModel.SessionPlans, Mode=OneWay}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="8" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:SessionPlanItem">
                            <Button
                                MinWidth="150"
                                HorizontalContentAlignment="Left"
                                Click="OnSelectSessionPlan"
                                Tag="{x:Bind}">
                                <StackPanel Spacing="1">
                                    <TextBlock
                                        MaxWidth="220"
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Text="{x:Bind Title}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        FontSize="10"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        Text="{x:Bind Subtitle}" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!--  Status bar  -->
        <Border
            Grid.Row="4"
            Padding="14,6"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0"
            Visibility="{x:Bind ViewModel.HasPlan, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <TextBlock
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind ViewModel.StatementSummary, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    HorizontalAlignment="Right"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Text="Scroll to zoom · drag to pan · double-click an operator to collapse it" />
            </Grid>
        </Border>
    </Grid>
</Page>
