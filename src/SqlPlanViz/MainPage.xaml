<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SqlPlanViz.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:SqlPlanViz.Controls"
    xmlns:capture="using:SqlPlanViz.Capture"
    xmlns:diag="using:SqlPlanViz.Diagnostics"
    xmlns:model="using:SqlPlanViz.Model"
    xmlns:vm="using:SqlPlanViz.ViewModels"
    xmlns:views="using:SqlPlanViz.Views"
    xmlns:themes="using:SqlPlanViz.Themes"
    xmlns:local="using:SqlPlanViz"
    Background="{ThemeResource GaugeBg0Brush}"
    FontFamily="{StaticResource GaugeSans}"
    FontSize="13"
    Foreground="{ThemeResource GaugeFg1Brush}"
    mc:Ignorable="d">

    <Grid AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--
            Title bar (PLATFORMS.md): 32px, bg-2, line bottom border. The app glyph is the one
            accent mark; the file name is fg-2. The palette button sits just left of the
            caption buttons (138px), in a passthrough region so it stays clickable.
        -->
        <Grid
            x:Name="AppTitleBar"
            Height="32"
            Padding="12,0,0,0"
            Background="{ThemeResource GaugeBg2Brush}"
            BorderBrush="{ThemeResource GaugeLineBrush}"
            BorderThickness="0,0,0,1"
            ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="138" />
            </Grid.ColumnDefinitions>
            <FontIcon
                Grid.Column="0"
                VerticalAlignment="Center"
                FontFamily="Segoe Fluent Icons"
                FontSize="15"
                Foreground="{ThemeResource GaugeAccentBrush}"
                Glyph="&#xE9D9;" />
            <TextBlock
                Grid.Column="1"
                VerticalAlignment="Center"
                FontSize="12.5"
                FontWeight="SemiBold"
                Foreground="{ThemeResource GaugeFg0Brush}"
                Text="SQL Plan Visualizer" />
            <TextBlock
                Grid.Column="2"
                VerticalAlignment="Center"
                FontSize="12"
                Foreground="{ThemeResource GaugeFg2Brush}"
                Text="{x:Bind ViewModel.SourceLabel, Mode=OneWay}"
                TextTrimming="CharacterEllipsis"
                Visibility="{x:Bind ViewModel.HasPlan, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
            <Button
                x:Name="PaletteButton"
                Grid.Column="3"
                MinHeight="22"
                Padding="8,1"
                AutomationProperties.Name="Find a command or operator"
                Click="OnOpenPalette"
                FontSize="12"
                Style="{StaticResource GaugeGhostButton}"
                ToolTipService.ToolTip="Command palette (Ctrl+K)">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock VerticalAlignment="Center" Text="Find a command or operator" />
                    <Border Style="{StaticResource GaugeKbd}">
                        <TextBlock Style="{StaticResource GaugeKbdText}" Text="Ctrl K" />
                    </Border>
                </StackPanel>
            </Button>
        </Grid>

        <!--
            Command bar (bg-2, line border, 6x12): file actions, the connection cluster, the
            plan-to-plan actions, then search and canvas navigation on the right.
        -->
        <Border
            Grid.Row="1"
            Padding="12,6"
            Background="{ThemeResource GaugeBg2Brush}"
            BorderBrush="{ThemeResource GaugeLineBrush}"
            BorderThickness="0,0,0,1">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel
                    Grid.Column="0"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button
                        AutomationProperties.Name="Open plan"
                        Click="OnOpenFile"
                        ToolTipService.ToolTip="Open a .sqlplan file (Ctrl+O)">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon
                                FontFamily="Segoe Fluent Icons"
                                FontSize="14"
                                Glyph="&#xE838;" />
                            <TextBlock Text="Open plan" />
                        </StackPanel>
                    </Button>
                    <Button
                        AutomationProperties.Name="Paste Showplan XML"
                        Click="OnPasteXml"
                        Style="{StaticResource GaugeIconButton}"
                        ToolTipService.ToolTip="Paste Showplan XML">
                        <FontIcon
                            FontFamily="Segoe Fluent Icons"
                            FontSize="14"
                            Glyph="&#xE77F;" />
                    </Button>

                    <Border
                        Width="1"
                        Margin="2,2"
                        Background="{ThemeResource GaugeLine2Brush}" />

                    <!--  Connection cluster  -->
                    <StackPanel
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="8"
                        ToolTipService.ToolTip="{x:Bind ViewModel.ConnectionDescription, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.IsConnected, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock
                            FontSize="12"
                            Style="{StaticResource GaugeSevOk}"
                            Text="Connected" />
                        <TextBlock
                            x:Name="ConnectionReadout"
                            MaxWidth="260"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource GaugeMono}"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource GaugeFg0Brush}"
                            Text="{x:Bind ViewModel.ConnectionTarget, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="{ThemeResource GaugeFg2Brush}"
                            Text="{x:Bind ViewModel.ConnectionAuthLabel, Mode=OneWay}" />
                        <Button
                            x:Name="DisconnectButton"
                            Click="OnDisconnect"
                            Content="Disconnect"
                            FontSize="12"
                            Style="{StaticResource GaugeGhostButton}"
                            ToolTipService.ToolTip="Disconnect from the current server" />
                    </StackPanel>
                    <StackPanel
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="8"
                        Visibility="{x:Bind ViewModel.IsNotConnected, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="{ThemeResource GaugeFg2Brush}"
                            Text="Not connected" />
                        <Button
                            AutomationProperties.Name="Connect"
                            Click="OnConnect"
                            FontSize="12"
                            ToolTipService.ToolTip="Open a connection to a SQL Server">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon
                                    FontFamily="Segoe Fluent Icons"
                                    FontSize="13"
                                    Glyph="&#xE71B;" />
                                <TextBlock Text="Connect" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <Border
                        Width="1"
                        Margin="2,2"
                        Background="{ThemeResource GaugeLine2Brush}" />

                    <Button
                        x:Name="CompareButton"
                        Click="OnCompareLatest"
                        Content="Compare"
                        IsEnabled="{x:Bind ViewModel.CanCompare, Mode=OneWay}"
                        Style="{StaticResource GaugeGhostButton}"
                        ToolTipService.ToolTip="Compare the two latest session plans" />
                    <Button
                        Click="OnRerunAndCompare"
                        Content="Re-run"
                        IsEnabled="{x:Bind ViewModel.CanRerun, Mode=OneWay}"
                        Style="{StaticResource GaugeGhostButton}"
                        ToolTipService.ToolTip="Re-run the last captured query and compare it with the prior plan" />
                    <Button
                        AutomationProperties.Name="Baseline"
                        IsEnabled="{x:Bind ViewModel.CanUseRegressionBaseline, Mode=OneWay}"
                        Style="{StaticResource GaugeGhostButton}"
                        ToolTipService.ToolTip="Save or check a regression baseline beside the plan file">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Baseline" />
                            <FontIcon
                                FontFamily="Segoe Fluent Icons"
                                FontSize="8"
                                Glyph="&#xE70D;" />
                        </StackPanel>
                        <Button.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Click="OnSaveRegressionBaseline" Text="Save baseline beside plan" />
                                <MenuFlyoutItem Click="OnCheckRegressionBaseline" Text="Check current plan" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>

                <StackPanel
                    Grid.Column="2"
                    Orientation="Horizontal"
                    Spacing="6">
                    <TextBox
                        x:Name="SearchBox"
                        Width="170"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Search operators"
                        FontSize="12.5"
                        PlaceholderText="Search operators…"
                        TextChanged="OnSearchChanged" />
                    <Button
                        x:Name="PlaybackButton"
                        AutomationProperties.Name="Play operators in execution order"
                        Click="OnTogglePlayback"
                        IsEnabled="{x:Bind ViewModel.HasPlan, Mode=OneWay}"
                        Style="{StaticResource GaugeIconButton}"
                        ToolTipService.ToolTip="Play operators in execution order">
                        <FontIcon
                            FontFamily="Segoe Fluent Icons"
                            FontSize="14"
                            Glyph="&#xE768;" />
                    </Button>
                    <Button
                        AutomationProperties.Name="Zoom out"
                        Click="OnZoomOut"
                        IsEnabled="{x:Bind ViewModel.HasPlan, Mode=OneWay}"
                        Style="{StaticResource GaugeIconButton}"
                        ToolTipService.ToolTip="Zoom out">
                        <FontIcon
                            FontFamily="Segoe Fluent Icons"
                            FontSize="14"
                            Glyph="&#xE738;" />
                    </Button>
                    <Button
                        AutomationProperties.Name="Zoom in"
                        Click="OnZoomIn"
                        IsEnabled="{x:Bind ViewModel.HasPlan, Mode=OneWay}"
                        Style="{StaticResource GaugeIconButton}"
                        ToolTipService.ToolTip="Zoom in">
                        <FontIcon
                            FontFamily="Segoe Fluent Icons"
                            FontSize="14"
                            Glyph="&#xE710;" />
                    </Button>
                    <Button
                        AutomationProperties.Name="Fit plan to window"
                        Click="OnFit"
                        IsEnabled="{x:Bind ViewModel.HasPlan, Mode=OneWay}"
                        Style="{StaticResource GaugeIconButton}"
                        ToolTipService.ToolTip="Fit plan to window">
                        <FontIcon
                            FontFamily="Segoe Fluent Icons"
                            FontSize="14"
                            Glyph="&#xE9A6;" />
                    </Button>
                    <Button
                        AutomationProperties.Name="Collapse or expand subtrees"
                        IsEnabled="{x:Bind ViewModel.HasPlan, Mode=OneWay}"
                        Style="{StaticResource GaugeIconButton}"
                        ToolTipService.ToolTip="Collapse / expand subtrees">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon
                                FontFamily="Segoe Fluent Icons"
                                FontSize="14"
                                Glyph="&#xF0E2;" />
                            <FontIcon
                                FontFamily="Segoe Fluent Icons"
                                FontSize="8"
                                Glyph="&#xE70D;" />
                        </StackPanel>
                        <Button.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Click="OnCollapseCheap" Text="Auto-collapse cheap subtrees (&lt;2%)" />
                                <MenuFlyoutItem Click="OnFocusHotPath" Text="Focus the hot path" />
                                <MenuFlyoutItem Click="OnCollapseAll" Text="Collapse all subtrees" />
                                <MenuFlyoutItem Click="OnExpandAll" Text="Expand everything" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!--
            Content: view rail (184px) / centre / inspector (minmax(340px, 29%), sized in
            OnContentSizeChanged), matching docs/design/gauge-mockup.html.
        -->
        <Grid
            x:Name="ContentGrid"
            Grid.Row="2"
            SizeChanged="OnContentSizeChanged">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="184" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="InspectorColumn" Width="400" />
            </Grid.ColumnDefinitions>

            <!--  View rail  -->
            <Border
                x:Name="ViewRail"
                Grid.Column="0"
                Background="{ThemeResource GaugeBg2Brush}"
                BorderBrush="{ThemeResource GaugeLineBrush}"
                BorderThickness="0,0,1,0">
                <Grid Padding="6,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock Style="{StaticResource GaugeNavGroupLabel}" Text="View" />
                    <RadioButton
                        x:Name="RailTree"
                        AutomationProperties.Name="Plan tree"
                        Checked="OnRailItemChecked"
                        GroupName="ViewRail"
                        Style="{StaticResource GaugeNavItem}"
                        Tag="Tree"
                        ToolTipService.ToolTip="The plan as a tree of operators (or a flame view)">
                        <Grid ColumnSpacing="9">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon
                                VerticalAlignment="Center"
                                FontFamily="Segoe Fluent Icons"
                                FontSize="15"
                                Glyph="&#xF003;" />
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Text="Plan tree"
                                TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </RadioButton>
                    <RadioButton
                        x:Name="RailRanked"
                        AutomationProperties.Name="Ranked by self time"
                        Checked="OnRailItemChecked"
                        GroupName="ViewRail"
                        Style="{StaticResource GaugeNavItem}"
                        Tag="Ranked"
                        ToolTipService.ToolTip="Every operator, most expensive first">
                        <Grid ColumnSpacing="9">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon
                                VerticalAlignment="Center"
                                FontFamily="Segoe Fluent Icons"
                                FontSize="15"
                                Glyph="&#xEA37;" />
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Text="Ranked by self time"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Grid.Column="2"
                                Style="{StaticResource GaugeCount}"
                                Text="{x:Bind ViewModel.RankedOperatorCountText, Mode=OneWay}" />
                        </Grid>
                    </RadioButton>
                    <RadioButton
                        x:Name="RailHistory"
                        AutomationProperties.Name="Query Store history"
                        Checked="OnRailItemChecked"
                        GroupName="ViewRail"
                        Style="{StaticResource GaugeNavItem}"
                        Tag="History"
                        ToolTipService.ToolTip="Plans Query Store kept for this query on the connected database">
                        <Grid ColumnSpacing="9">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon
                                VerticalAlignment="Center"
                                FontFamily="Segoe Fluent Icons"
                                FontSize="15"
                                Glyph="&#xE81C;" />
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Text="Query Store history"
                                TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </RadioButton>
                    <RadioButton
                        x:Name="RailLibrary"
                        AutomationProperties.Name="Anti-pattern library"
                        Checked="OnRailItemChecked"
                        GroupName="ViewRail"
                        Style="{StaticResource GaugeNavItem}"
                        Tag="Library"
                        ToolTipService.ToolTip="Named plan anti-patterns and how to spot them">
                        <Grid ColumnSpacing="9">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon
                                VerticalAlignment="Center"
                                FontFamily="Segoe Fluent Icons"
                                FontSize="15"
                                Glyph="&#xE8A5;" />
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Text="Anti-pattern library"
                                TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </RadioButton>
                    </StackPanel>

                    <Border
                        Grid.Row="1"
                        Height="1"
                        Margin="2,5"
                        Background="{ThemeResource GaugeLineBrush}" />

                    <TextBlock
                        Grid.Row="2"
                        Style="{StaticResource GaugeNavGroupLabel}"
                        Text="Session plans" />

                    <!--  Every plan opened or captured this session; the current one is highlighted.  -->
                    <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock
                                Margin="9,4"
                                FontSize="12"
                                Foreground="{ThemeResource GaugeFg2Brush}"
                                Text="Plans you open or capture this session appear here."
                                TextWrapping="Wrap"
                                Visibility="{x:Bind ViewModel.HasSessionPlans, Mode=OneWay, Converter={StaticResource InverseBoolToVisibility}}" />
                            <ItemsControl ItemsSource="{x:Bind ViewModel.SessionPlans, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:SessionPlanItem">
                                        <Grid Margin="0,0,0,2">
                                            <Border
                                                Background="{ThemeResource GaugeBg3Brush}"
                                                CornerRadius="{StaticResource GaugeR3}"
                                                Visibility="{x:Bind IsCurrent, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                            <Button
                                                AutomationProperties.Name="{x:Bind Title}"
                                                Click="OnSelectSessionPlan"
                                                Style="{StaticResource GaugeNavRowButton}"
                                                Tag="{x:Bind}"
                                                ToolTipService.ToolTip="{x:Bind Subtitle}">
                                                <StackPanel>
                                                    <TextBlock
                                                        Foreground="{ThemeResource GaugeFg0Brush}"
                                                        Text="{x:Bind Title}"
                                                        TextTrimming="CharacterEllipsis" />
                                                    <TextBlock
                                                        FontSize="11.5"
                                                        Foreground="{ThemeResource GaugeFg2Brush}"
                                                        Text="{x:Bind RailSubtitle}" />
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Grid x:Name="LeftContent" Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition x:Name="EditorPaneRow" Height="286" />
                </Grid.RowDefinitions>
                <!--
                    Centre pane header: which statement, then the canvas controls - Weigh by
                    (7 metrics, so a select rather than a segmented control), Blame, the
                    Detail cycle and the Tree/Flame segmented control.
                -->
                <Border
                    x:Name="CentreHeader"
                    Grid.Row="0"
                    Style="{StaticResource GaugePaneHeader}"
                    Visibility="{x:Bind ViewModel.HasPlan, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            Style="{StaticResource GaugePaneTitle}"
                            Text="{x:Bind ViewModel.StatementTitle, Mode=OneWay}" />
                        <ComboBox
                            x:Name="StatementPicker"
                            Grid.Column="1"
                            MaxWidth="260"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="Statement in this batch"
                            ItemsSource="{x:Bind ViewModel.Statements, Mode=OneWay}"
                            SelectedItem="{x:Bind ViewModel.SelectedStatement, Mode=TwoWay}"
                            ToolTipService.ToolTip="Statement in this batch"
                            Visibility="{x:Bind ViewModel.HasMultipleStatements, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="model:PlanStatement">
                                    <TextBlock Text="{x:Bind Summary.ShortText}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock
                            Grid.Column="2"
                            Style="{StaticResource GaugeFacts}"
                            Text="{x:Bind ViewModel.StatementFacts, Mode=OneWay}" />

                        <StackPanel
                            Grid.Column="3"
                            Orientation="Horizontal"
                            Spacing="8">
                            <TextBlock Style="{StaticResource GaugeInlineLabel}" Text="Weigh by" />
                            <ComboBox
                                x:Name="MetricSelector"
                                MinWidth="122"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="Weigh nodes by"
                                FontSize="12.5"
                                SelectedIndex="0"
                                SelectionChanged="OnMetricChanged"
                                ToolTipService.ToolTip="What sizes and heats each node card">
                                <ComboBoxItem Content="Subtree cost" />
                                <ComboBoxItem Content="Operator cost" />
                                <ComboBoxItem x:Name="RowsMetricItem" Content="Actual rows" />
                                <ComboBoxItem x:Name="TimeMetricItem" Content="Elapsed time" />
                                <ComboBoxItem x:Name="SelfTimeMetricItem" Content="Self time" />
                                <ComboBoxItem x:Name="EfficiencyMetricItem" Content="Efficiency" />
                                <ComboBoxItem x:Name="EstimateSkewMetricItem" Content="Estimate skew" />
                            </ComboBox>
                            <ToggleButton
                                x:Name="BlameToggleButton"
                                Click="OnToggleColorMode"
                                Content="Blame"
                                FontSize="12.5"
                                ToolTipService.ToolTip="Colour nodes by finding severity instead of the selected metric" />
                            <Button
                                x:Name="LabelDetailButton"
                                Click="OnToggleLabelDetail"
                                Content="Detail: Full"
                                FontSize="12.5"
                                Style="{StaticResource GaugeGhostButton}"
                                ToolTipService.ToolTip="Cycle how much text each node card shows: full, standard, or operator name only" />

                            <Border AutomationProperties.Name="Canvas view" Style="{StaticResource GaugeSegmented}">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton
                                        x:Name="TreeModeRadio"
                                        Checked="OnCanvasModeChecked"
                                        Content="Tree"
                                        GroupName="CanvasMode"
                                        IsChecked="True"
                                        Style="{StaticResource GaugeSegmentItemFirst}"
                                        ToolTipService.ToolTip="The plan as a tree of operators" />
                                    <RadioButton
                                        x:Name="FlameModeRadio"
                                        Checked="OnCanvasModeChecked"
                                        Content="Flame"
                                        GroupName="CanvasMode"
                                        Style="{StaticResource GaugeSegmentItem}"
                                        ToolTipService.ToolTip="Time attribution as a flame view" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <controls:PlanCanvas
                    x:Name="Canvas"
                    Grid.Row="1"
                    FilterText="{x:Bind ViewModel.FilterText, Mode=OneWay}"
                    ExplanationVerbosity="{x:Bind ViewModel.ExplanationVerbosity, Mode=OneWay}"
                    LayoutChanged="OnCanvasLayoutChanged"
                    Metric="{x:Bind ViewModel.Metric, Mode=OneWay}"
                    SelectedNode="{x:Bind ViewModel.SelectedNode, Mode=TwoWay}"
                    Statement="{x:Bind ViewModel.SelectedStatement, Mode=OneWay}" />

                <views:FlameView
                    x:Name="Flame"
                    Grid.Row="1"
                    Visibility="Collapsed"
                    SelectedNode="{x:Bind ViewModel.SelectedNode, Mode=TwoWay}"
                    Statement="{x:Bind ViewModel.SelectedStatement, Mode=OneWay}" />

                <!--  Focus breadcrumb: a secondary button on the canvas, back out of a focused subtree.  -->
                <Button
                    x:Name="FocusBreadcrumbButton"
                    Grid.Row="1"
                    Margin="12"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    AutomationProperties.Name="Leave the focused subtree"
                    Background="{ThemeResource GaugeBg2Brush}"
                    Click="OnExitFocus"
                    FontSize="12.5"
                    Style="{StaticResource GaugeGhostButton}"
                    Visibility="Collapsed" />

                <Border
                    x:Name="OperatorListPane"
                    Grid.Row="1"
                    Margin="14"
                    Padding="12"
                    Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Visibility="Collapsed">
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <TextBlock
                                FontSize="16"
                                FontWeight="SemiBold"
                                Text="{x:Bind ViewModel.RankedOperatorsTitle, Mode=OneWay}" />
                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
                                <ToggleButton
                                    Content="Sort by divergence"
                                    IsChecked="{x:Bind ViewModel.RankOperatorsByDivergence, Mode=TwoWay}"
                                    ToolTipService.ToolTip="Sort by |estimated cost share − actual time share| instead of self time" />
                                <Button Click="OnBackToTree" Content="Back to tree" />
                            </StackPanel>
                        </Grid>
                        <ListView
                            Grid.Row="1"
                            ItemsSource="{x:Bind ViewModel.RankedOperators, Mode=OneWay}">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:OperatorRankItem">
                                    <Button
                                        Margin="0,0,0,4"
                                        Padding="10,8"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Click="OnJumpToRankedOperator"
                                        Tag="{x:Bind Node}">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="42" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                FontSize="14"
                                                FontWeight="SemiBold"
                                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                Text="{x:Bind RankText}" />
                                            <StackPanel Grid.Column="1" Spacing="2">
                                                <TextBlock FontWeight="SemiBold" Text="{x:Bind Title}" />
                                                <TextBlock
                                                    FontSize="11"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Text="{x:Bind Subtitle}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <TextBlock
                                                    FontSize="11"
                                                    Foreground="{x:Bind DivergenceExceedsThreshold, Converter={StaticResource DivergenceForeground}}"
                                                    Text="{x:Bind DivergenceText}"
                                                    Visibility="{x:Bind HasDivergence, Converter={StaticResource BoolToVisibility}}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                                <TextBlock HorizontalAlignment="Right" Text="{x:Bind PrimaryMetric}" />
                                                <TextBlock
                                                    HorizontalAlignment="Right"
                                                    FontSize="11"
                                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                    Text="{x:Bind RowsText}" />
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>

                <Border
                    x:Name="QueryStorePane"
                    Grid.Row="1"
                    Margin="14"
                    Padding="12"
                    Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Visibility="Collapsed">
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <TextBlock FontSize="16" FontWeight="SemiBold" Text="Query Store plan history" />
                            <Button HorizontalAlignment="Right" Click="OnBackToTree" Content="Back to tree" />
                        </Grid>
                        <Grid Grid.Row="1">
                            <ProgressRing IsActive="{x:Bind ViewModel.IsLoadingQueryStore, Mode=OneWay}" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind ViewModel.QueryStoreMessage, Mode=OneWay}"
                                TextWrapping="Wrap" />
                            <ListView ItemsSource="{x:Bind ViewModel.QueryStorePlans, Mode=OneWay}">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="capture:QueryStorePlanEntry">
                                        <Button
                                            Margin="0,0,0,4"
                                            Padding="10,8"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Click="OnOpenQueryStorePlan"
                                            Tag="{x:Bind}">
                                            <StackPanel Spacing="2">
                                                <TextBlock FontWeight="SemiBold" Text="{x:Bind Title}" TextWrapping="Wrap" />
                                                <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind Detail}" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Grid>
                </Border>

                <Border
                    x:Name="AntiPatternPane"
                    Grid.Row="1"
                    Margin="14"
                    Padding="12"
                    Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Visibility="Collapsed">
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <TextBlock FontSize="16" FontWeight="SemiBold" Text="Plan anti-pattern library" />
                            <Button HorizontalAlignment="Right" Click="OnBackToTree" Content="Back to tree" />
                        </Grid>
                        <ScrollViewer Grid.Row="1">
                            <ItemsControl ItemsSource="{x:Bind AntiPatterns}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="diag:AntiPatternInfo">
                                        <Expander Margin="0,0,0,8" Header="{x:Bind Name}">
                                            <StackPanel Padding="0,8,0,4" Spacing="6">
                                                <TextBlock FontWeight="SemiBold" Text="{x:Bind Summary}" TextWrapping="Wrap" />
                                                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind Explanation}" TextWrapping="Wrap" />
                                                <TextBlock FontFamily="{StaticResource GaugeMono}" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="{x:Bind RuleId}" />
                                            </StackPanel>
                                        </Expander>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!--
                    Empty state: an 18px heading, the ways in (Open is the view's one primary),
                    then saved profiles as a table whose names connect.
                -->
                <StackPanel
                    Grid.Row="0"
                    Grid.RowSpan="4"
                    Width="560"
                    Margin="76,46,40,40"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Visibility="{x:Bind ViewModel.HasNoPlan, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock
                        Margin="0,0,0,6"
                        FontSize="18"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource GaugeFg0Brush}"
                        Text="No plan loaded" />
                    <TextBlock
                        Margin="0,0,0,16"
                        Foreground="{ThemeResource GaugeFg1Brush}"
                        LineHeight="19"
                        TextWrapping="Wrap">
                        <Run Text="Drop a " /><Run FontFamily="{StaticResource GaugeMono}" FontSize="12" Text=".sqlplan" /><Run Text=" file here, open one, paste Showplan XML, or capture a plan straight from a live SQL Server connection." />
                    </TextBlock>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button
                            Click="OnOpenFile"
                            Content="Open a .sqlplan file"
                            Style="{StaticResource GaugePrimaryButton}" />
                        <Button Click="OnPasteXml" Content="Paste XML" />
                        <Button Click="OnCapture" Content="Capture from server" />
                    </StackPanel>

                    <StackPanel x:Name="ProfilesPanel" Visibility="Collapsed">
                        <TextBlock
                            Margin="0,28,0,8"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource GaugeFg0Brush}"
                            Text="Or connect to a saved profile" />
                        <Border BorderBrush="{ThemeResource GaugeLineBrush}" BorderThickness="1">
                            <StackPanel>
                                <Grid
                                    Padding="14,6"
                                    Background="{ThemeResource GaugeBg2Brush}"
                                    ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="114" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource GaugeTableHeaderText}" Text="Profile" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Style="{StaticResource GaugeTableHeaderText}"
                                        Text="Server · database" />
                                    <TextBlock
                                        Grid.Column="2"
                                        Style="{StaticResource GaugeTableHeaderText}"
                                        Text="Authentication" />
                                </Grid>
                                <ItemsControl IsTabStop="False" ItemsSource="{x:Bind ConnectionProfiles, Mode=OneWay}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="capture:ConnectionProfile">
                                            <Button
                                                AutomationProperties.Name="{x:Bind Name}"
                                                Click="OnConnectProfile"
                                                IsTabStop="False"
                                                Style="{StaticResource GaugeRowButton}">
                                                <Grid
                                                    Padding="14,6"
                                                    BorderBrush="{ThemeResource GaugeLineBrush}"
                                                    BorderThickness="0,1,0,0"
                                                    ColumnSpacing="14">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="114" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <HyperlinkButton
                                                        Click="OnConnectProfile"
                                                        Content="{x:Bind Name}"
                                                        Style="{StaticResource GaugeEntityLinkSans}"
                                                        ToolTipService.ToolTip="Connect with this profile" />
                                                    <TextBlock
                                                        Grid.Column="1"
                                                        VerticalAlignment="Center"
                                                        FontFamily="{StaticResource GaugeMono}"
                                                        FontSize="12"
                                                        Foreground="{ThemeResource GaugeFg0Brush}"
                                                        Text="{x:Bind local:MainPage.ProfileTarget(Server, Database)}"
                                                        TextTrimming="CharacterEllipsis" />
                                                    <TextBlock
                                                        Grid.Column="2"
                                                        VerticalAlignment="Center"
                                                        Foreground="{ThemeResource GaugeFg1Brush}"
                                                        Text="{x:Bind local:MainPage.ProfileAuth(Auth, PasswordIsVaulted, IsRawConnectionString)}"
                                                        TextAlignment="Right" />
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <!--  Error: a crit callout carrying the problem, with a dismiss button.  -->
                <Border
                    Grid.Row="1"
                    MaxWidth="640"
                    Margin="14"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Padding="16,10,8,12"
                    Style="{StaticResource GaugeCalloutCrit}"
                    Visibility="{x:Bind ViewModel.HasError, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="4">
                            <TextBlock Style="{StaticResource GaugeSevCrit}" Text="Could not load that plan" />
                            <TextBlock
                                IsTextSelectionEnabled="True"
                                Style="{StaticResource GaugeCalloutText}"
                                Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />
                        </StackPanel>
                        <Button
                            Grid.Column="1"
                            VerticalAlignment="Top"
                            AutomationProperties.Name="Dismiss"
                            Click="OnDismissError"
                            Style="{StaticResource GaugeIconButton}"
                            ToolTipService.ToolTip="Dismiss">
                            <FontIcon
                                FontFamily="Segoe Fluent Icons"
                                FontSize="12"
                                Glyph="&#xE711;" />
                        </Button>
                    </Grid>
                </Border>

                <!--  Busy  -->
                <Grid
                    Grid.Row="1"
                    Background="{ThemeResource GaugeScrimBrush}"
                    Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <Border
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Padding="18,14"
                        Background="{ThemeResource GaugeBg2Brush}"
                        BorderBrush="{ThemeResource GaugeLine2Brush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource GaugeRDialog}">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <ProgressRing
                                Width="20"
                                Height="20"
                                Foreground="{ThemeResource GaugeAccentBrush}"
                                IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
                            <TextBlock
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource GaugeFg0Brush}"
                                Text="{x:Bind ViewModel.BusyMessage, Mode=OneWay}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!--
                    The editor pane (docs/live-plan-editor-plan.md). The read-only SQL strip
                    it replaces could only ever show you the SQL; this can change it, compile
                    it, and say whether the change helped.
                -->
                <controls:PaneSplitter
                    x:Name="EditorSplitter"
                    Grid.Row="2"
                    Visibility="{x:Bind ViewModel.HasPlan, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />

                <Border
                    x:Name="EditorPane"
                    Grid.Row="3"
                    Background="{ThemeResource GaugeBg1Brush}"
                    Visibility="{x:Bind ViewModel.HasPlan, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!--
                            The cost delta bar. First of the four Phase 5 surfaces because it
                            needs no text mapping at all — just PlanDiff against the pinned
                            baseline — so it is the one signal that is never a guess.
                        -->
                        <Border
                            x:Name="CostBar"
                            Padding="14,5"
                            Background="{ThemeResource GaugeBg2Brush}"
                            BorderBrush="{ThemeResource GaugeLineBrush}"
                            BorderThickness="0,0,0,1">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <!--  Verdict: a word first (Better / Worse), coloured ok / crit, then the numbers in fg-0.  -->
                                <TextBlock
                                    x:Name="CostBarHeadline"
                                    VerticalAlignment="Center"
                                    FontSize="12.5"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource GaugeFg0Brush}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    x:Name="CostBarDetail"
                                    Grid.Column="1"
                                    Style="{StaticResource GaugeFacts}" />
                                <StackPanel
                                    Grid.Column="2"
                                    Orientation="Horizontal"
                                    Spacing="8">
                                    <Button
                                        x:Name="PinBaselineButton"
                                        Click="OnPinBaseline"
                                        Content="Pin current as baseline"
                                        FontSize="12.5"
                                        Style="{StaticResource GaugeGhostButton}"
                                        ToolTipService.ToolTip="Re-anchor the comparison to the plan on screen, once an improvement is banked" />
                                    <Button
                                        x:Name="RefreshCatalogButton"
                                        Click="OnRefreshCatalog"
                                        Content="Refresh schema"
                                        FontSize="12.5"
                                        Style="{StaticResource GaugeGhostButton}"
                                        ToolTipService.ToolTip="Re-read tables, columns and indexes from the connected database" />
                                    <ToggleButton
                                        x:Name="AnnotationsToggle"
                                        Click="OnToggleInlineAnnotations"
                                        Content="Annotations"
                                        FontSize="12.5"
                                        IsChecked="True"
                                        ToolTipService.ToolTip="Show end-of-line delta annotations in the editor" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!--
                            SQL pane header: title, where the selected operator maps (an entity
                            link back to it) and the caret position, then the editor actions.
                            Re-plan is the workbench's one accent-filled primary.
                        -->
                        <Border
                            Grid.Row="1"
                            Padding="14,5"
                            BorderBrush="{ThemeResource GaugeLineBrush}"
                            BorderThickness="0,0,0,1">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    FontSize="12.5"
                                    Style="{StaticResource GaugePaneTitle}"
                                    Text="SQL" />

                                <StackPanel
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">
                                    <TextBlock x:Name="SqlMappingLabel" Style="{StaticResource GaugeFacts}" />
                                    <TextBlock
                                        x:Name="SqlMappingClause"
                                        Margin="4,0,4,0"
                                        FontFamily="{StaticResource GaugeMono}"
                                        FontSize="12"
                                        Style="{StaticResource GaugeFacts}" />
                                    <TextBlock x:Name="SqlMappingJoin" Style="{StaticResource GaugeFacts}" />
                                    <HyperlinkButton
                                        x:Name="SqlMappingEntity"
                                        Margin="4,0,0,0"
                                        Click="OnSqlMappingEntity"
                                        FontSize="12.5"
                                        Style="{StaticResource GaugeEntityLinkSans}"
                                        ToolTipService.ToolTip="Show this operator in the plan"
                                        Visibility="Collapsed" />
                                    <TextBlock x:Name="EditorStatusText" Style="{StaticResource GaugeFacts}" />
                                </StackPanel>

                                <StackPanel
                                    Grid.Column="2"
                                    Orientation="Horizontal"
                                    Spacing="8">
                                    <ProgressRing
                                        x:Name="EditorBusyRing"
                                        Width="16"
                                        Height="16"
                                        VerticalAlignment="Center"
                                        Foreground="{ThemeResource GaugeAccentBrush}"
                                        IsActive="{x:Bind ViewModel.Editor.IsBusy, Mode=OneWay}"
                                        Visibility="{x:Bind ViewModel.Editor.IsBusy, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                    <Button
                                        x:Name="SqlFormatButton"
                                        Click="OnFormatSql"
                                        Content="Format"
                                        FontSize="12.5"
                                        Style="{StaticResource GaugeGhostButton}"
                                        ToolTipService.ToolTip="Re-lay out the batch, one clause per line (Shift+Alt+F)" />
                                    <Button
                                        AutomationProperties.Name="Copy the statement"
                                        Click="OnCopySql"
                                        Style="{StaticResource GaugeIconButton}"
                                        ToolTipService.ToolTip="Copy the statement">
                                        <FontIcon
                                            FontFamily="Segoe Fluent Icons"
                                            FontSize="14"
                                            Glyph="&#xE8C8;" />
                                    </Button>
                                    <Button
                                        x:Name="CancelReplanButton"
                                        Click="OnCancelReplan"
                                        Content="Cancel"
                                        FontSize="12.5"
                                        Style="{StaticResource GaugeGhostButton}"
                                        Visibility="{x:Bind ViewModel.Editor.IsBusy, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                    <Button
                                        x:Name="RunActualButton"
                                        Click="OnRunActual"
                                        Content="Run for actual…"
                                        FontSize="12.5"
                                        ToolTipService.ToolTip="Execute the batch and capture measured row counts and timings; asks for confirmation first" />
                                    <Button
                                        x:Name="ReplanButton"
                                        AutomationProperties.Name="Re-plan"
                                        Click="OnReplan"
                                        FontSize="12.5"
                                        Style="{StaticResource GaugePrimaryButton}"
                                        ToolTipService.ToolTip="Compile the edited batch and swap in its plan (Ctrl+Enter)">
                                        <StackPanel Orientation="Horizontal" Spacing="7">
                                            <FontIcon
                                                FontFamily="Segoe Fluent Icons"
                                                FontSize="12"
                                                Glyph="&#xE768;" />
                                            <TextBlock Text="Re-plan" />
                                            <!--  The kbd on a filled button takes the button's ink, not the bg-2 chip.  -->
                                            <Border
                                                Padding="5,0"
                                                VerticalAlignment="Center"
                                                BorderBrush="{ThemeResource GaugeAccentInkBrush}"
                                                BorderThickness="1,1,1,2"
                                                CornerRadius="{StaticResource GaugeR3}">
                                                <TextBlock
                                                    FontFamily="{StaticResource GaugeMono}"
                                                    FontSize="11"
                                                    FontWeight="Normal"
                                                    Text="Ctrl &#x21B5;" />
                                            </Border>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <controls:SqlEditorControl x:Name="SqlEditor" Grid.Row="2" />

                        <views:ParameterStrip x:Name="Parameters" Grid.Row="3" />
                    </Grid>
                </Border>
            </Grid>

            <!--  Inspector  -->
            <Border
                Grid.Column="2"
                Background="{ThemeResource GaugeBg1Brush}"
                BorderBrush="{ThemeResource GaugeLineBrush}"
                BorderThickness="1,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!--
                        Diagnosis header: the counts as severity words, Terse / Detailed as a
                        segmented control, and copy-as-Markdown.
                    -->
                    <Border Grid.Row="0" Style="{StaticResource GaugePaneHeader}">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource GaugePaneTitle}" Text="Diagnosis" />
                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <TextBlock Style="{StaticResource GaugeSevCrit}" Text="{x:Bind ViewModel.CriticalCountText, Mode=OneWay}" />
                                <TextBlock
                                    Margin="4,0"
                                    Style="{StaticResource GaugeFacts}"
                                    Text="·"
                                    Visibility="{x:Bind ViewModel.HasBothSeverityCounts, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock Style="{StaticResource GaugeSevWarn}" Text="{x:Bind ViewModel.WarningFindingCountText, Mode=OneWay}" />
                            </StackPanel>
                            <StackPanel
                                Grid.Column="2"
                                Orientation="Horizontal"
                                Spacing="8"
                                Visibility="{x:Bind ViewModel.HasPlan, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                <Border AutomationProperties.Name="Explanations" Style="{StaticResource GaugeSegmented}">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton
                                            x:Name="TerseRadio"
                                            Checked="OnVerbosityChecked"
                                            Content="Terse"
                                            GroupName="Verbosity"
                                            Style="{StaticResource GaugeSegmentItemFirst}"
                                            ToolTipService.ToolTip="One-sentence explanations" />
                                        <RadioButton
                                            x:Name="DetailedRadio"
                                            Checked="OnVerbosityChecked"
                                            Content="Detailed"
                                            GroupName="Verbosity"
                                            IsChecked="True"
                                            Style="{StaticResource GaugeSegmentItem}"
                                            ToolTipService.ToolTip="Full explanations with context and next steps" />
                                    </StackPanel>
                                </Border>
                                <Button
                                    AutomationProperties.Name="Copy diagnosis as Markdown"
                                    Click="OnCopyDiagnosis"
                                    Style="{StaticResource GaugeIconButton}"
                                    ToolTipService.ToolTip="Copy diagnosis as Markdown">
                                    <FontIcon
                                        FontFamily="Segoe Fluent Icons"
                                        FontSize="14"
                                        Glyph="&#xE8C8;" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!--
                        Narrative: a callout with the operators as entity links back to the
                        canvas, bold metrics, and a bold "Next step:" lead.
                    -->
                    <Border
                        Grid.Row="1"
                        Margin="14,10,14,0"
                        Padding="16,10"
                        Style="{StaticResource GaugeCallout}"
                        Visibility="{x:Bind ViewModel.HasPlan, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <RichTextBlock
                            x:Name="NarrativeText"
                            FontSize="12.5"
                            Foreground="{ThemeResource GaugeFg1Brush}"
                            IsTextSelectionEnabled="True"
                            LineHeight="18"
                            TextWrapping="Wrap" />
                    </Border>

                    <!--  Inspector view: a segmented control over the same five panes.  -->
                    <Border
                        Grid.Row="2"
                        Padding="14,10,14,8"
                        BorderBrush="{ThemeResource GaugeLineBrush}"
                        BorderThickness="0,0,0,1"
                        Visibility="{x:Bind ViewModel.HasPlan, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <Border
                            x:Name="PaneSelector"
                            AutomationProperties.Name="Inspector view"
                            Style="{StaticResource GaugeSegmented}">
                            <StackPanel Orientation="Horizontal">
                            <RadioButton
                                x:Name="FindingsTab"
                                Checked="OnInspectorTabChecked"
                                Content="Findings"
                                GroupName="InspectorTab"
                                IsChecked="True"
                                Style="{StaticResource GaugeSegmentItemFirst}"
                                Tag="0" />
                            <RadioButton
                                x:Name="OperatorTab"
                                Checked="OnInspectorTabChecked"
                                Content="Operator"
                                GroupName="InspectorTab"
                                Style="{StaticResource GaugeSegmentItem}"
                                Tag="1" />
                            <RadioButton
                                x:Name="IndexesTab"
                                Checked="OnInspectorTabChecked"
                                Content="Indexes"
                                GroupName="InspectorTab"
                                Style="{StaticResource GaugeSegmentItem}"
                                Tag="2" />
                            <RadioButton
                                x:Name="WarningsTab"
                                Checked="OnInspectorTabChecked"
                                Content="Warnings"
                                GroupName="InspectorTab"
                                Style="{StaticResource GaugeSegmentItem}"
                                Tag="3" />
                            <RadioButton
                                x:Name="DeltaTab"
                                Checked="OnInspectorTabChecked"
                                Content="Delta"
                                GroupName="InspectorTab"
                                Style="{StaticResource GaugeSegmentItem}"
                                Tag="4" />
                            </StackPanel>
                        </Border>
                    </Border>

                    <TextBlock
                        Grid.Row="3"
                        Margin="14,12,14,0"
                        Foreground="{ThemeResource GaugeFg2Brush}"
                        LineHeight="19"
                        Text="Open or capture a plan to see ranked findings, operator details, index suggestions and warnings here."
                        TextWrapping="Wrap"
                        Visibility="{x:Bind ViewModel.HasNoPlan, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />

                    <!--
                        Findings as dense rows: severity word, title, impact; the description;
                        then the operator as an entity link, confidence and triage. The selected
                        finding is drawn as a selected record and expands inline on bg-0.
                    -->
                    <ScrollViewer
                        x:Name="FindingsPane"
                        Grid.Row="3"
                        Padding="0"
                        Visibility="{x:Bind ViewModel.HasPlan, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock
                                Margin="14,16,14,0"
                                Foreground="{ThemeResource GaugeFg2Brush}"
                                TextWrapping="Wrap"
                                Text="No diagnostic findings for the available plan data."
                                Visibility="{x:Bind ViewModel.HasFindings, Mode=OneWay, Converter={StaticResource InverseBoolToVisibility}}" />

                            <ItemsControl IsTabStop="False" ItemsSource="{x:Bind ViewModel.Findings, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:FindingItem">
                                        <StackPanel>
                                            <Button
                                                AutomationProperties.Name="{x:Bind Title}"
                                                BorderBrush="{ThemeResource GaugeLineBrush}"
                                                Click="OnSelectFinding"
                                                IsTabStop="False"
                                                Style="{StaticResource GaugeRowButton}"
                                                Tag="{x:Bind}">
                                                <Grid Background="{x:Bind themes:GaugeBrushes.RowFill(IsSelected), Mode=OneWay}" BorderBrush="{ThemeResource GaugeLineBrush}" BorderThickness="0,0,0,1">
                                                    <Rectangle
                                                        Width="2"
                                                        HorizontalAlignment="Left"
                                                        Fill="{x:Bind themes:GaugeBrushes.RowEdge(IsSelected), Mode=OneWay}" />
                                                    <StackPanel Padding="14,8,14,9" Spacing="2">
                                                        <Grid ColumnSpacing="10">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock
                                                                FontSize="13"
                                                                FontWeight="SemiBold"
                                                                Foreground="{x:Bind themes:GaugeBrushes.Severity(Severity, IsSelected), Mode=OneWay}"
                                                                Text="{x:Bind SeverityWord}" />
                                                            <TextBlock
                                                                Grid.Column="1"
                                                                FontWeight="SemiBold"
                                                                Foreground="{x:Bind themes:GaugeBrushes.RowText(IsSelected), Mode=OneWay}"
                                                                Text="{x:Bind Name}"
                                                                TextTrimming="CharacterEllipsis" />
                                                            <TextBlock
                                                                Grid.Column="2"
                                                                FontWeight="SemiBold"
                                                                Foreground="{x:Bind themes:GaugeBrushes.RowText(IsSelected), Mode=OneWay}"
                                                                Text="{x:Bind ImpactShort}" />
                                                        </Grid>
                                                        <TextBlock
                                                            Foreground="{x:Bind themes:GaugeBrushes.RowBody(IsSelected), Mode=OneWay}"
                                                            Text="{x:Bind Description}"
                                                            TextWrapping="Wrap" />
                                                        <Grid ColumnSpacing="10">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <HyperlinkButton
                                                                AutomationProperties.Name="{x:Bind NodeEntity}"
                                                                BorderBrush="{x:Bind themes:GaugeBrushes.RowUnderline(IsSelected), Mode=OneWay}"
                                                                Click="OnFindingEntity"
                                                                Content="{x:Bind NodeEntity}"
                                                                FontSize="12.5"
                                                                Foreground="{x:Bind themes:GaugeBrushes.RowText(IsSelected), Mode=OneWay}"
                                                                Style="{StaticResource GaugeEntityLinkSans}"
                                                                Tag="{x:Bind}"
                                                                ToolTipService.ToolTip="Select this finding and show its operator in the plan" />
                                                            <TextBlock
                                                                Grid.Column="1"
                                                                VerticalAlignment="Center"
                                                                FontSize="12"
                                                                Foreground="{x:Bind themes:GaugeBrushes.RowMeta(IsSelected), Mode=OneWay}"
                                                                Text="{x:Bind ConfidenceLower}" />
                                                            <TextBlock
                                                                Grid.Column="2"
                                                                VerticalAlignment="Center"
                                                                FontSize="12"
                                                                Foreground="{x:Bind themes:GaugeBrushes.RowMeta(IsSelected), Mode=OneWay}"
                                                                Text="{x:Bind TriageWord, Mode=OneWay}" />
                                                        </Grid>
                                                    </StackPanel>
                                                </Grid>
                                            </Button>

                                            <!--  The selected finding, expanded: why, fixes, what-if, actions, triage.  -->
                                            <Border
                                                Padding="14,10,14,14"
                                                Background="{ThemeResource GaugeBg0Brush}"
                                                BorderBrush="{ThemeResource GaugeLineBrush}"
                                                BorderThickness="0,0,0,1"
                                                Visibility="{x:Bind IsSelected, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                                <StackPanel Spacing="4">
                                                    <TextBlock Style="{StaticResource SectionHeader}" Text="Why it matters" />
                                                    <TextBlock
                                                        Foreground="{ThemeResource GaugeFg1Brush}"
                                                        IsTextSelectionEnabled="True"
                                                        Text="{x:Bind Why}"
                                                        TextWrapping="Wrap" />

                                                    <TextBlock
                                                        Margin="0,8,0,4"
                                                        Style="{StaticResource SectionHeader}"
                                                        Text="Fixes, most effective first"
                                                        Visibility="{x:Bind HasFixes, Converter={StaticResource BoolToVisibility}}" />
                                                    <ItemsControl IsTabStop="False" ItemsSource="{x:Bind Fixes}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="vm:FindingFixItem">
                                                                <Grid Margin="0,0,0,6" ColumnSpacing="6">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="18" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Foreground="{ThemeResource GaugeFg1Brush}" Text="{x:Bind Number}" />
                                                                    <StackPanel Grid.Column="1" Spacing="4">
                                                                        <TextBlock
                                                                            Foreground="{ThemeResource GaugeFg1Brush}"
                                                                            IsTextSelectionEnabled="True"
                                                                            Text="{x:Bind Summary}"
                                                                            TextWrapping="Wrap" />
                                                                        <Border
                                                                            Padding="8,6"
                                                                            Background="{ThemeResource GaugeBg1Brush}"
                                                                            BorderBrush="{ThemeResource GaugeLineBrush}"
                                                                            BorderThickness="1"
                                                                            CornerRadius="{StaticResource GaugeR3}"
                                                                            Visibility="{x:Bind HasSnippet, Converter={StaticResource BoolToVisibility}}">
                                                                            <TextBlock Style="{StaticResource CodeText}" Text="{x:Bind Snippet}" />
                                                                        </Border>
                                                                        <TextBlock
                                                                            FontSize="12"
                                                                            Foreground="{ThemeResource GaugeFg2Brush}"
                                                                            Text="{x:Bind Caveat}"
                                                                            TextWrapping="Wrap"
                                                                            Visibility="{x:Bind HasCaveat, Converter={StaticResource BoolToVisibility}}" />
                                                                    </StackPanel>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>

                                                    <Border
                                                        Margin="0,4,0,4"
                                                        Padding="10,8"
                                                        BorderBrush="{ThemeResource GaugeLine2Brush}"
                                                        BorderThickness="1"
                                                        CornerRadius="{StaticResource GaugeR3}"
                                                        Visibility="{x:Bind HasWhatIf, Converter={StaticResource BoolToVisibility}}">
                                                        <StackPanel Spacing="2">
                                                            <TextBlock
                                                                FontSize="11.5"
                                                                FontWeight="SemiBold"
                                                                Foreground="{ThemeResource GaugeFg2Brush}"
                                                                Text="Approximate what-if" />
                                                            <TextBlock
                                                                Foreground="{ThemeResource GaugeFg0Brush}"
                                                                Text="{x:Bind WhatIf.Summary}"
                                                                TextWrapping="Wrap" />
                                                            <TextBlock
                                                                FontSize="11.5"
                                                                Foreground="{ThemeResource GaugeFg2Brush}"
                                                                Text="Directional estimate only; re-run the query to measure the real result."
                                                                TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </Border>

                                                    <Grid Margin="0,6,0,0" ColumnSpacing="8" RowSpacing="8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>
                                                        <Button
                                                            Click="OnFindingShowInPlan"
                                                            Content="Show in plan"
                                                            Tag="{x:Bind}" />
                                                        <Button
                                                            Grid.Column="1"
                                                            Click="OnFindingOpenLibrary"
                                                            Content="Open in library"
                                                            Style="{StaticResource GaugeGhostButton}"
                                                            Tag="{x:Bind}" />
                                                        <Border
                                                            Grid.Row="1"
                                                            Grid.ColumnSpan="3"
                                                            HorizontalAlignment="Right"
                                                            AutomationProperties.Name="Triage"
                                                            IsHitTestVisible="{x:Bind CanPersist}"
                                                            Opacity="{x:Bind local:MainPage.EnabledOpacity(CanPersist)}"
                                                            Style="{StaticResource GaugeSegmented}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <RadioButton
                                                                    Click="OnTriageTried"
                                                                    Content="Tried"
                                                                    GroupName="{x:Bind PersistenceKey}"
                                                                    IsChecked="{x:Bind IsTried, Mode=OneWay}"
                                                                    Style="{StaticResource GaugeSegmentItemFirst}"
                                                                    Tag="{x:Bind}" />
                                                                <RadioButton
                                                                    Click="OnTriageDidNotHelp"
                                                                    Content="No help"
                                                                    GroupName="{x:Bind PersistenceKey}"
                                                                    IsChecked="{x:Bind IsDidNotHelp, Mode=OneWay}"
                                                                    Style="{StaticResource GaugeSegmentItem}"
                                                                    Tag="{x:Bind}" />
                                                                <RadioButton
                                                                    Click="OnTriageFixed"
                                                                    Content="Fixed"
                                                                    GroupName="{x:Bind PersistenceKey}"
                                                                    IsChecked="{x:Bind IsFixed, Mode=OneWay}"
                                                                    Style="{StaticResource GaugeSegmentItem}"
                                                                    Tag="{x:Bind}" />
                                                                <Button
                                                                    Click="OnTriageReset"
                                                                    Content="Reset"
                                                                    Style="{StaticResource GaugeSegmentButton}"
                                                                    Tag="{x:Bind}" />
                                                            </StackPanel>
                                                        </Border>
                                                    </Grid>
                                                    <TextBlock
                                                        Margin="0,6,0,0"
                                                        FontSize="11.5"
                                                        Foreground="{ThemeResource GaugeFg2Brush}"
                                                        Text="Triage is saved beside file-backed plans." />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <!--
                        Operator: a header, then each section under its own pane header with a
                        key-value grid (labels fg-2, values fg-0 right-aligned), mono predicates,
                        and the annotation and live object context as plain collapsible sections.
                    -->
                    <ScrollViewer
                        x:Name="OperatorPane"
                        Grid.Row="3"
                        Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock
                                Margin="14,16,14,0"
                                Foreground="{ThemeResource GaugeFg2Brush}"
                                TextWrapping="Wrap"
                                Text="Select an operator in the plan to see its rows, cost and predicates."
                                Visibility="{x:Bind ViewModel.HasNoSelection, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />

                            <StackPanel Visibility="{x:Bind ViewModel.HasSelection, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel Padding="14,10,14,10" Spacing="2">
                                    <TextBlock
                                        FontSize="15"
                                        Style="{StaticResource GaugePaneTitle}"
                                        Text="{x:Bind ViewModel.SelectedDetail.Title, Mode=OneWay}"
                                        TextWrapping="Wrap" />
                                    <TextBlock Style="{StaticResource GaugeFacts}" Text="{x:Bind ViewModel.SelectedDetail.Subtitle, Mode=OneWay}" />
                                    <TextBlock
                                        Margin="0,2,0,0"
                                        FontFamily="{StaticResource GaugeMono}"
                                        FontSize="12"
                                        Foreground="{ThemeResource GaugeCodeBrush}"
                                        IsTextSelectionEnabled="True"
                                        Text="{x:Bind ViewModel.SelectedDetail.ObjectName, Mode=OneWay}"
                                        TextWrapping="Wrap"
                                        Visibility="{x:Bind ViewModel.SelectedDetail.HasObject, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>

                                <Border
                                    Padding="14,7"
                                    BorderBrush="{ThemeResource GaugeLineBrush}"
                                    BorderThickness="0,1,0,1">
                                    <TextBlock
                                        FontSize="13"
                                        Style="{StaticResource GaugePaneTitle}"
                                        Text="Rows" />
                                </Border>
                                <StackPanel Padding="14,8,14,12" Spacing="6">
                                    <TextBlock
                                        Foreground="{ThemeResource GaugeFg1Brush}"
                                        Text="{x:Bind ViewModel.SelectedDetail.EstimateVerdict, Mode=OneWay}"
                                        TextWrapping="Wrap" />
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="62" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Estimated" />
                                        <ProgressBar
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Maximum="100"
                                            Style="{StaticResource GaugeBar}"
                                            Value="{x:Bind ViewModel.SelectedDetail.EstimatedBar, Mode=OneWay}" />
                                        <TextBlock
                                            Grid.Column="2"
                                            Style="{StaticResource FieldValue}"
                                            Text="{x:Bind ViewModel.SelectedDetail.EstimatedRowsText, Mode=OneWay}" />
                                    </Grid>
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="62" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Actual" />
                                        <ProgressBar
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Maximum="100"
                                            Style="{StaticResource GaugeBar}"
                                            Value="{x:Bind ViewModel.SelectedDetail.ActualBar, Mode=OneWay}" />
                                        <TextBlock
                                            Grid.Column="2"
                                            Style="{StaticResource FieldValue}"
                                            Text="{x:Bind ViewModel.SelectedDetail.ActualRowsText, Mode=OneWay}" />
                                    </Grid>
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{ThemeResource GaugeFg2Brush}"
                                        Text="{x:Bind ViewModel.SelectedDetail.EstimatePerExecutionNote, Mode=OneWay}"
                                        TextWrapping="Wrap"
                                        Visibility="{x:Bind ViewModel.SelectedDetail.HasEstimatePerExecutionNote, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>

                                <Border
                                    Padding="14,7"
                                    BorderBrush="{ThemeResource GaugeLineBrush}"
                                    BorderThickness="0,1,0,1">
                                    <TextBlock
                                        FontSize="13"
                                        Style="{StaticResource GaugePaneTitle}"
                                        Text="Cost" />
                                </Border>
                                <StackPanel Padding="14,8,14,12" Spacing="6">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Subtree" />
                                        <TextBlock
                                            Grid.Column="1"
                                            Style="{StaticResource FieldValue}"
                                            Text="{x:Bind ViewModel.SelectedDetail.SubtreeCostText, Mode=OneWay}" />
                                    </Grid>
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="This operator" />
                                        <TextBlock
                                            Grid.Column="1"
                                            Style="{StaticResource FieldValue}"
                                            Text="{x:Bind ViewModel.SelectedDetail.OperatorCostText, Mode=OneWay}" />
                                    </Grid>
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Share of statement" />
                                        <TextBlock
                                            Grid.Column="1"
                                            Style="{StaticResource FieldValue}"
                                            Text="{x:Bind ViewModel.SelectedDetail.CostShareText, Mode=OneWay}" />
                                    </Grid>
                                    <TextBlock
                                        Margin="0,4,0,0"
                                        Style="{StaticResource SectionHeader}"
                                        Text="CPU vs I/O" />
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="36" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="CPU" />
                                        <ProgressBar
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Maximum="100"
                                            Style="{StaticResource GaugeBar}"
                                            Value="{x:Bind ViewModel.SelectedDetail.CpuBar, Mode=OneWay}" />
                                        <TextBlock
                                            Grid.Column="2"
                                            Style="{StaticResource FieldValue}"
                                            Text="{x:Bind ViewModel.SelectedDetail.CpuCostText, Mode=OneWay}" />
                                    </Grid>
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="36" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="I/O" />
                                        <ProgressBar
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Maximum="100"
                                            Style="{StaticResource GaugeBar}"
                                            Value="{x:Bind ViewModel.SelectedDetail.IoBar, Mode=OneWay}" />
                                        <TextBlock
                                            Grid.Column="2"
                                            Style="{StaticResource FieldValue}"
                                            Text="{x:Bind ViewModel.SelectedDetail.IoCostText, Mode=OneWay}" />
                                    </Grid>
                                </StackPanel>

                                <StackPanel Visibility="{x:Bind ViewModel.SelectedDetail.HasTiming, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                <Border
                                    Padding="14,7"
                                    BorderBrush="{ThemeResource GaugeLineBrush}"
                                    BorderThickness="0,1,0,1">
                                    <TextBlock
                                        FontSize="13"
                                        Style="{StaticResource GaugePaneTitle}"
                                        Text="Timing" />
                                </Border>
                                    <StackPanel Padding="14,8,14,12" Spacing="6">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Elapsed (slowest thread)" />
                                        <TextBlock
                                            Grid.Column="1"
                                            Style="{StaticResource FieldValue}"
                                            Text="{x:Bind ViewModel.SelectedDetail.ElapsedText, Mode=OneWay}" />
                                    </Grid>
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="CPU (all threads)" />
                                        <TextBlock
                                            Grid.Column="1"
                                            Style="{StaticResource FieldValue}"
                                            Text="{x:Bind ViewModel.SelectedDetail.ActualCpuText, Mode=OneWay}" />
                                    </Grid>
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Executions" />
                                        <TextBlock
                                            Grid.Column="1"
                                            Style="{StaticResource FieldValue}"
                                            Text="{x:Bind ViewModel.SelectedDetail.ExecutionsText, Mode=OneWay}" />
                                    </Grid>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Visibility="{x:Bind ViewModel.SelectedDetail.HasSeekPredicate, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                <Border
                                    Padding="14,7"
                                    BorderBrush="{ThemeResource GaugeLineBrush}"
                                    BorderThickness="0,1,0,1">
                                    <TextBlock
                                        FontSize="13"
                                        Style="{StaticResource GaugePaneTitle}"
                                        Text="Seek predicate" />
                                </Border>
                                    <TextBlock
                                        Margin="14,8,14,12"
                                        Style="{StaticResource CodeText}"
                                        Text="{x:Bind ViewModel.SelectedDetail.SeekPredicate, Mode=OneWay}" />
                                </StackPanel>

                                <StackPanel Visibility="{x:Bind ViewModel.SelectedDetail.HasPredicate, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                <Border
                                    Padding="14,7"
                                    BorderBrush="{ThemeResource GaugeLineBrush}"
                                    BorderThickness="0,1,0,1">
                                    <TextBlock
                                        FontSize="13"
                                        Style="{StaticResource GaugePaneTitle}"
                                        Text="Predicate" />
                                </Border>
                                    <TextBlock
                                        Margin="14,8,14,12"
                                        Style="{StaticResource CodeText}"
                                        Text="{x:Bind ViewModel.SelectedDetail.Predicate, Mode=OneWay}" />
                                </StackPanel>

                                <StackPanel Visibility="{x:Bind ViewModel.SelectedDetail.HasWarnings, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                <Border
                                    Padding="14,7"
                                    BorderBrush="{ThemeResource GaugeLineBrush}"
                                    BorderThickness="0,1,0,1">
                                    <TextBlock
                                        FontSize="13"
                                        Style="{StaticResource GaugePaneTitle}"
                                        Text="Warnings on this operator" />
                                </Border>
                                    <ItemsControl IsTabStop="False" ItemsSource="{x:Bind ViewModel.SelectedDetail.Warnings, Mode=OneWay}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:WarningItem">
                                                <StackPanel
                                                    Padding="14,7"
                                                    BorderBrush="{ThemeResource GaugeLineBrush}"
                                                    BorderThickness="0,0,0,1"
                                                    Spacing="2">
                                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                                        <TextBlock
                                                            FontSize="13"
                                                            FontWeight="SemiBold"
                                                            Foreground="{x:Bind themes:GaugeBrushes.Warning(Severity)}"
                                                            Text="{x:Bind SeverityWord}" />
                                                        <TextBlock
                                                            FontWeight="SemiBold"
                                                            Foreground="{ThemeResource GaugeFg0Brush}"
                                                            Text="{x:Bind Title}"
                                                            TextWrapping="Wrap" />
                                                    </StackPanel>
                                                    <TextBlock
                                                        FontSize="12"
                                                        Foreground="{ThemeResource GaugeFg2Brush}"
                                                        Text="{x:Bind Detail}"
                                                        TextWrapping="Wrap"
                                                        Visibility="{x:Bind HasDetail, Converter={StaticResource BoolToVisibility}}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <StackPanel Visibility="{x:Bind ViewModel.SelectedDetail.HasOutputList, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                <!--  OutputList: a plain collapsible section.  -->
                                <Border
                                    Padding="14,6"
                                    BorderBrush="{ThemeResource GaugeLineBrush}"
                                    BorderThickness="0,1,0,0">
                                    <ToggleButton
                                        x:Name="OutputListToggle"
                                        AutomationProperties.Name="OutputList"
                                        Click="OnToggleOperatorSection"
                                        Style="{StaticResource GaugeDisclosureToggle}"
                                        Tag="OutputListBody">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon
                                                VerticalAlignment="Center"
                                                FontFamily="Segoe Fluent Icons"
                                                FontSize="10"
                                                Glyph="&#xE76C;" />
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontSize="13"
                                                FontWeight="SemiBold"
                                                Text="{x:Bind ViewModel.SelectedDetail.OutputListHeader, Mode=OneWay}" />
                                        </StackPanel>
                                    </ToggleButton>
                                </Border>
                                <StackPanel
                                    x:Name="OutputListBody"
                                    Padding="14,0,14,10"
                                    Spacing="8"
                                    Visibility="Collapsed">
                                    <ItemsControl IsTabStop="False" ItemsSource="{x:Bind ViewModel.SelectedDetail.OutputList, Mode=OneWay}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <TextBlock Style="{StaticResource CodeText}" Text="{x:Bind}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                                </StackPanel>
                                <!--  Annotation: a plain collapsible section.  -->
                                <Border
                                    Padding="14,6"
                                    BorderBrush="{ThemeResource GaugeLineBrush}"
                                    BorderThickness="0,1,0,0">
                                    <ToggleButton
                                        x:Name="AnnotationToggle"
                                        AutomationProperties.Name="Annotation"
                                        Click="OnToggleOperatorSection"
                                        Style="{StaticResource GaugeDisclosureToggle}"
                                        Tag="AnnotationBody">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon
                                                VerticalAlignment="Center"
                                                FontFamily="Segoe Fluent Icons"
                                                FontSize="10"
                                                Glyph="&#xE76C;" />
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontSize="13"
                                                FontWeight="SemiBold"
                                                Text="Annotation" />
                                        </StackPanel>
                                    </ToggleButton>
                                </Border>
                                <StackPanel
                                    x:Name="AnnotationBody"
                                    Padding="14,0,14,10"
                                    Spacing="8"
                                    Visibility="Collapsed">
                                    <TextBox
                                        MinHeight="64"
                                        AcceptsReturn="True"
                                        AutomationProperties.Name="Annotation"
                                        PlaceholderText="Add a note about this operator…"
                                        Text="{x:Bind ViewModel.SelectedAnnotation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        TextWrapping="Wrap" />
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="11.5"
                                            Foreground="{ThemeResource GaugeFg2Brush}"
                                            Text="{x:Bind ViewModel.AnnotationHint, Mode=OneWay}"
                                            TextWrapping="Wrap" />
                                        <Button
                                            Grid.Column="1"
                                            Click="OnSaveAnnotation"
                                            Content="Save note"
                                            IsEnabled="{x:Bind ViewModel.CanAnnotate, Mode=OneWay}" />
                                    </Grid>
                                </StackPanel>
                                <!--  Live object context: a plain collapsible section.  -->
                                <Border
                                    Padding="14,6"
                                    BorderBrush="{ThemeResource GaugeLineBrush}"
                                    BorderThickness="0,1,0,0">
                                    <ToggleButton
                                        x:Name="LiveContextToggle"
                                        AutomationProperties.Name="Live object context"
                                        Click="OnToggleOperatorSection"
                                        Style="{StaticResource GaugeDisclosureToggle}"
                                        Tag="LiveContextBody">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon
                                                VerticalAlignment="Center"
                                                FontFamily="Segoe Fluent Icons"
                                                FontSize="10"
                                                Glyph="&#xE76C;" />
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontSize="13"
                                                FontWeight="SemiBold"
                                                Text="Live object context" />
                                        </StackPanel>
                                    </ToggleButton>
                                </Border>
                                <StackPanel
                                    x:Name="LiveContextBody"
                                    Padding="14,0,14,10"
                                    Spacing="8"
                                    Visibility="Collapsed">
                                    <ProgressRing
                                        Width="16"
                                        Height="16"
                                        HorizontalAlignment="Left"
                                        Foreground="{ThemeResource GaugeAccentBrush}"
                                        IsActive="{x:Bind ViewModel.IsLoadingObjectContext, Mode=OneWay}"
                                        Visibility="{x:Bind ViewModel.IsLoadingObjectContext, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                    <TextBlock
                                        Foreground="{ThemeResource GaugeFg2Brush}"
                                        Text="{x:Bind ViewModel.ObjectContextMessage, Mode=OneWay}"
                                        TextWrapping="Wrap"
                                        Visibility="{x:Bind ViewModel.HasNoObjectContext, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                    <StackPanel
                                        Spacing="6"
                                        Visibility="{x:Bind ViewModel.HasObjectContext, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock
                                            FontFamily="{StaticResource GaugeMono}"
                                            FontSize="12"
                                            Foreground="{ThemeResource GaugeFg0Brush}"
                                            Text="{x:Bind ViewModel.SelectedObjectContext.DisplayName, Mode=OneWay}" />
                                        <TextBlock Foreground="{ThemeResource GaugeFg1Brush}" Text="{x:Bind ViewModel.SelectedObjectContext.RowCountText, Mode=OneWay}" />
                                        <TextBlock Foreground="{ThemeResource GaugeFg1Brush}" Text="{x:Bind ViewModel.SelectedObjectContext.SizeText, Mode=OneWay}" />
                                        <TextBlock Margin="0,4,0,0" Style="{StaticResource SectionHeader}" Text="Indexes" />
                                        <ItemsControl IsTabStop="False" ItemsSource="{x:Bind ViewModel.SelectedObjectContext.Indexes, Mode=OneWay}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="capture:DatabaseIndexInfo">
                                                    <StackPanel Margin="0,0,0,6">
                                                        <TextBlock
                                                            FontFamily="{StaticResource GaugeMono}"
                                                            FontSize="12"
                                                            Foreground="{ThemeResource GaugeFg0Brush}"
                                                            Text="{x:Bind Name}" />
                                                        <TextBlock FontSize="12" Foreground="{ThemeResource GaugeFg2Brush}" Text="{x:Bind Kind}" />
                                                        <TextBlock FontSize="12" Foreground="{ThemeResource GaugeFg1Brush}" Text="{x:Bind ColumnSummary}" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Margin="0,4,0,0" Style="{StaticResource SectionHeader}" Text="Statistics" />
                                        <ItemsControl IsTabStop="False" ItemsSource="{x:Bind ViewModel.SelectedObjectContext.Statistics, Mode=OneWay}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="capture:DatabaseStatisticInfo">
                                                    <StackPanel Margin="0,0,0,6">
                                                        <TextBlock
                                                            FontFamily="{StaticResource GaugeMono}"
                                                            FontSize="12"
                                                            Foreground="{ThemeResource GaugeFg0Brush}"
                                                            Text="{x:Bind Name}" />
                                                        <TextBlock FontSize="12" Foreground="{ThemeResource GaugeFg2Brush}" Text="{x:Bind Detail}" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!--
                        Indexes: GaugeTable rows - the target and impact, its columns, whether it
                        already exists, and the DDL as mono in a bg-0 block with a Copy button.
                    -->
                    <ScrollViewer
                        x:Name="IndexesPane"
                        Grid.Row="3"
                        Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock
                                Margin="14,16,14,0"
                                Foreground="{ThemeResource GaugeFg2Brush}"
                                TextWrapping="Wrap"
                                Text="This plan carries no missing-index suggestions."
                                Visibility="{x:Bind ViewModel.HasMissingIndexes, Mode=OneWay, Converter={StaticResource InverseBoolToVisibility}}" />

                            <ItemsControl IsTabStop="False" ItemsSource="{x:Bind ViewModel.MissingIndexes, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:IndexSuggestionItem">
                                        <StackPanel
                                            Padding="14,9,14,12"
                                            BorderBrush="{ThemeResource GaugeLineBrush}"
                                            BorderThickness="0,0,0,1"
                                            Spacing="4">
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                    FontFamily="{StaticResource GaugeMono}"
                                                    FontSize="12"
                                                    FontWeight="SemiBold"
                                                    Foreground="{ThemeResource GaugeFg0Brush}"
                                                    Text="{x:Bind DisplayTarget}"
                                                    TextWrapping="Wrap" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    FontWeight="SemiBold"
                                                    Foreground="{ThemeResource GaugeFg0Brush}"
                                                    Text="{x:Bind ImpactText}" />
                                            </Grid>
                                            <TextBlock
                                                FontSize="12"
                                                Foreground="{ThemeResource GaugeFg2Brush}"
                                                Text="{x:Bind ColumnSummary}"
                                                TextWrapping="Wrap" />
                                            <TextBlock
                                                FontSize="12"
                                                Foreground="{ThemeResource GaugeFg1Brush}"
                                                Text="{x:Bind VerificationText, Mode=OneWay}"
                                                TextWrapping="Wrap" />

                                            <Grid
                                                Margin="0,4,0,0"
                                                Padding="10,8,6,8"
                                                Background="{ThemeResource GaugeBg0Brush}"
                                                BorderBrush="{ThemeResource GaugeLineBrush}"
                                                BorderThickness="1"
                                                ColumnSpacing="8"
                                                CornerRadius="{StaticResource GaugeR3}"
                                                Visibility="{x:Bind CanShowScript, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Style="{StaticResource CodeText}" Text="{x:Bind SuggestedCreateStatement}" />
                                                <Button
                                                    Grid.Column="1"
                                                    VerticalAlignment="Top"
                                                    AutomationProperties.Name="Copy the CREATE INDEX statement"
                                                    Click="OnCopyIndexScript"
                                                    FontSize="12.5"
                                                    Style="{StaticResource GaugeGhostButton}"
                                                    Tag="{x:Bind SuggestedCreateStatement}">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <FontIcon
                                                            FontFamily="Segoe Fluent Icons"
                                                            FontSize="13"
                                                            Glyph="&#xE8C8;" />
                                                        <TextBlock Text="Copy" />
                                                    </StackPanel>
                                                </Button>
                                            </Grid>

                                            <TextBlock
                                                FontSize="12"
                                                Foreground="{ThemeResource GaugeFg2Brush}"
                                                Text="{x:Bind Caveat}"
                                                TextWrapping="Wrap"
                                                Visibility="{x:Bind CanShowScript, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <!--  Warnings: rows with a severity word, the warning, its operator and the detail.  -->
                    <ScrollViewer
                        x:Name="WarningsPane"
                        Grid.Row="3"
                        Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock
                                Margin="14,16,14,0"
                                Foreground="{ThemeResource GaugeFg2Brush}"
                                TextWrapping="Wrap"
                                Text="No warnings in this plan."
                                Visibility="{x:Bind ViewModel.HasWarnings, Mode=OneWay, Converter={StaticResource InverseBoolToVisibility}}" />

                            <ItemsControl IsTabStop="False" ItemsSource="{x:Bind ViewModel.Warnings, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:WarningItem">
                                        <Button
                                            AutomationProperties.Name="{x:Bind Title}"
                                            Click="OnJumpToWarning"
                                            Style="{StaticResource GaugeRowButton}"
                                            Tag="{x:Bind Node}"
                                            ToolTipService.ToolTip="Show this operator in the plan">
                                            <StackPanel
                                                Padding="14,8,14,9"
                                                BorderBrush="{ThemeResource GaugeLineBrush}"
                                                BorderThickness="0,0,0,1"
                                                Spacing="2">
                                                <StackPanel Orientation="Horizontal" Spacing="10">
                                                    <TextBlock
                                                        FontSize="13"
                                                        FontWeight="SemiBold"
                                                        Foreground="{x:Bind themes:GaugeBrushes.Warning(Severity)}"
                                                        Text="{x:Bind SeverityWord}" />
                                                    <TextBlock
                                                        FontWeight="SemiBold"
                                                        Foreground="{ThemeResource GaugeFg0Brush}"
                                                        Text="{x:Bind Title}"
                                                        TextWrapping="Wrap" />
                                                </StackPanel>
                                                <TextBlock
                                                    FontSize="12"
                                                    Foreground="{ThemeResource GaugeFg2Brush}"
                                                    Text="{x:Bind Location}" />
                                                <TextBlock
                                                    FontSize="12"
                                                    Foreground="{ThemeResource GaugeFg1Brush}"
                                                    Text="{x:Bind Detail}"
                                                    TextWrapping="Wrap"
                                                    Visibility="{x:Bind HasDetail, Converter={StaticResource BoolToVisibility}}" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <!--  Delta: a pane header with the sort, then a GaugeTable of per-operator changes.  -->
                    <Grid
                        x:Name="DeltaPane"
                        Grid.Row="3"
                        Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Style="{StaticResource GaugePaneHeader}">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    FontSize="13"
                                    Style="{StaticResource GaugePaneTitle}"
                                    Text="Plan comparison" />
                                <TextBlock
                                    Grid.Column="1"
                                    HorizontalAlignment="Right"
                                    Style="{StaticResource GaugeInlineLabel}"
                                    Text="Sort by" />
                                <ComboBox
                                    Grid.Column="2"
                                    MinWidth="170"
                                    AutomationProperties.Name="Sort deltas by"
                                    FontSize="12.5"
                                    SelectedIndex="0"
                                    SelectionChanged="OnDeltaSortChanged">
                                    <ComboBoxItem Content="Largest cost regression" />
                                    <ComboBoxItem Content="Largest row change" />
                                    <ComboBoxItem Content="Change type" />
                                    <ComboBoxItem Content="Operator name" />
                                </ComboBox>
                            </Grid>
                        </Border>

                        <TextBlock
                            Grid.Row="2"
                            Margin="14,16,14,0"
                            Foreground="{ThemeResource GaugeFg2Brush}"
                            Text="Compare the two latest session plans to see metric deltas."
                            TextWrapping="Wrap"
                            Visibility="{x:Bind ViewModel.HasDiff, Mode=OneWay, Converter={StaticResource InverseBoolToVisibility}}" />

                        <Grid
                            Grid.Row="1"
                            Padding="14,6"
                            Background="{ThemeResource GaugeBg2Brush}"
                            ColumnSpacing="10"
                            Visibility="{x:Bind ViewModel.HasDiff, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="72" />
                                <ColumnDefinition Width="72" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource GaugeTableHeaderText}" Text="Operator" />
                            <TextBlock
                                Grid.Column="1"
                                HorizontalAlignment="Right"
                                Style="{StaticResource GaugeTableHeaderText}"
                                Text="Cost Δ" />
                            <TextBlock
                                Grid.Column="2"
                                HorizontalAlignment="Right"
                                Style="{StaticResource GaugeTableHeaderText}"
                                Text="Rows Δ" />
                        </Grid>

                        <ScrollViewer Grid.Row="2">
                            <ItemsControl IsTabStop="False" ItemsSource="{x:Bind ViewModel.DiffDeltas, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:PlanDeltaItem">
                                        <Button
                                            AutomationProperties.Name="{x:Bind Operator}"
                                            Click="OnJumpToDelta"
                                            Style="{StaticResource GaugeRowButton}"
                                            Tag="{x:Bind TargetNode}">
                                            <Grid
                                                Padding="14,6"
                                                BorderBrush="{ThemeResource GaugeLineBrush}"
                                                BorderThickness="0,0,0,1"
                                                ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="72" />
                                                    <ColumnDefinition Width="72" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <TextBlock
                                                            FontWeight="SemiBold"
                                                            Foreground="{ThemeResource GaugeFg0Brush}"
                                                            Text="{x:Bind Operator}" />
                                                        <TextBlock
                                                            VerticalAlignment="Center"
                                                            FontSize="12"
                                                            Foreground="{ThemeResource GaugeFg2Brush}"
                                                            Text="{x:Bind Change}" />
                                                    </StackPanel>
                                                    <TextBlock
                                                        FontFamily="{StaticResource GaugeMono}"
                                                        FontSize="11.5"
                                                        Foreground="{ThemeResource GaugeFg2Brush}"
                                                        Text="{x:Bind ObjectName}"
                                                        TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <TextBlock
                                                    Grid.Column="1"
                                                    HorizontalAlignment="Right"
                                                    Foreground="{ThemeResource GaugeFg0Brush}"
                                                    Text="{x:Bind CostDeltaText}" />
                                                <TextBlock
                                                    Grid.Column="2"
                                                    HorizontalAlignment="Right"
                                                    Foreground="{ThemeResource GaugeFg0Brush}"
                                                    Text="{x:Bind RowsDeltaText}" />
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!--
            Status bar (24px, bg-2, 11.5px fg-2): counts on the left; the canvas hint and the
            theme control on the right.
        -->
        <Border Grid.Row="3" Style="{StaticResource GaugeStatusBar}">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ItemsControl
                    VerticalAlignment="Center"
                    IsTabStop="False"
                    ItemsSource="{x:Bind ViewModel.StatusItems, Mode=OneWay}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="16" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <TextBlock Style="{StaticResource GaugeStatusText}" Text="{x:Bind}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock
                    Grid.Column="1"
                    Style="{StaticResource GaugeStatusText}"
                    Text="Scroll to zoom · drag to pan · double-click an operator to collapse it"
                    TextTrimming="CharacterEllipsis" />
                <StackPanel
                    Grid.Column="2"
                    Orientation="Horizontal"
                    Spacing="6">
                    <TextBlock Style="{StaticResource GaugeStatusText}" Text="Theme" />
                    <ComboBox
                        x:Name="ThemePicker"
                        MinWidth="66"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Theme"
                        SelectionChanged="OnThemeChanged"
                        Style="{StaticResource GaugeCompactComboBox}">
                        <ComboBoxItem Content="System" />
                        <ComboBoxItem Content="Light" />
                        <ComboBoxItem Content="Dark" />
                    </ComboBox>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
