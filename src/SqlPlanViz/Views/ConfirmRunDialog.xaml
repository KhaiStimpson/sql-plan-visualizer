<UserControl
    x:Class="SqlPlanViz.Views.ConfirmRunDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
        docs/live-plan-editor-plan.md Phase 7, in the Gauge dialog (gauge-mockup.html#run). The
        mistake this exists to prevent is running a dev query against production: the server
        and login are named in the header (see Subtitle), every modifying statement is listed
        with its line, and running stays behind a tick box and is never the default action.
    -->
    <StackPanel Width="464" Spacing="12">
        <StackPanel Spacing="4">
            <TextBlock x:Name="HeadlineText" TextWrapping="Wrap" />

            <Border
                x:Name="StatementsCard"
                MaxHeight="180"
                BorderBrush="{ThemeResource GaugeLineBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource GaugeR3}">
                <ScrollViewer>
                    <ItemsControl x:Name="StatementsHost" IsTabStop="False" />
                </ScrollViewer>
            </Border>
        </StackPanel>

        <RichTextBlock
            FontSize="13"
            Foreground="{ThemeResource GaugeFg2Brush}"
            IsTextSelectionEnabled="False"
            LineHeight="19">
            <Paragraph>
                <Run Text="An estimated plan needs none of this. " />
                <InlineUIContainer>
                    <Border Margin="0,0,0,-4" Style="{StaticResource GaugeKbd}">
                        <TextBlock Style="{StaticResource GaugeKbdText}" Text="Ctrl &#x21B5;" />
                    </Border>
                </InlineUIContainer>
                <Run Text=" compiles without executing. Run this only when you need measured row counts and timings." />
            </Paragraph>
        </RichTextBlock>

        <CheckBox
            x:Name="ConfirmCheck"
            Checked="OnConfirmChanged"
            Unchecked="OnConfirmChanged">
            <TextBlock x:Name="ConfirmText" TextWrapping="Wrap" />
        </CheckBox>
    </StackPanel>
</UserControl>
