<UserControl
    x:Class="SqlPlanViz.Views.FlameView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Basis selector  -->
        <StackPanel
            x:Name="ControlBar"
            Grid.Row="0"
            Margin="14,14,14,8"
            Orientation="Horizontal"
            Spacing="10">
            <TextBlock
                VerticalAlignment="Center"
                FontWeight="SemiBold"
                Text="Time attribution" />
            <SelectorBar x:Name="BasisSelector" SelectionChanged="OnBasisChanged">
                <SelectorBarItem IsSelected="True" Text="Elapsed time" />
                <SelectorBarItem Text="CPU time" />
                <SelectorBarItem Text="Rows read" />
            </SelectorBar>
        </StackPanel>

        <!--  Basis-reliability warnings, shown only when relevant  -->
        <StackPanel Grid.Row="1" Spacing="4">
            <InfoBar
                x:Name="ApproximateWarning"
                Margin="14,0,14,0"
                IsClosable="False"
                IsOpen="False"
                Severity="Informational"
                Title="Widths are approximate under parallelism">
                <InfoBar.Content>
                    <TextBlock
                        Text="Elapsed time is a max-across-threads figure below a parallel operator, so sibling widths here don't literally add up to their parent's. Switch to CPU time for an additive basis."
                        TextWrapping="Wrap" />
                </InfoBar.Content>
            </InfoBar>

            <InfoBar
                x:Name="NegativeSelfWarning"
                Margin="14,0,14,8"
                IsClosable="False"
                IsOpen="False"
                Severity="Warning"
                Title="This basis doesn't fully account for its own children">
                <InfoBar.Content>
                    <TextBlock x:Name="NegativeSelfWarningBody" TextWrapping="Wrap" />
                </InfoBar.Content>
            </InfoBar>
        </StackPanel>

        <!--  Disabled-state message, shown in place of the flame chart when there are no runtime stats  -->
        <StackPanel
            x:Name="DisabledPanel"
            Grid.Row="2"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="8"
            Visibility="Collapsed">
            <TextBlock
                HorizontalAlignment="Center"
                FontSize="16"
                FontWeight="SemiBold"
                Text="No runtime stats to attribute" />
            <TextBlock
                MaxWidth="360"
                HorizontalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="This is an estimated plan — there's no actual elapsed time, CPU time, or row count to build a flame graph from. Capture an actual plan to use this view."
                TextAlignment="Center"
                TextWrapping="Wrap" />
        </StackPanel>

        <ScrollViewer
            x:Name="FlameScroller"
            Grid.Row="2"
            HorizontalScrollBarVisibility="Disabled"
            SizeChanged="OnScrollerSizeChanged"
            VerticalScrollBarVisibility="Auto">
            <Canvas x:Name="FlameCanvas" Margin="14,4,14,14" />
        </ScrollViewer>
    </Grid>
</UserControl>
