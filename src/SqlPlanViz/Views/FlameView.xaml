<UserControl
    x:Class="SqlPlanViz.Views.FlameView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="{ThemeResource GaugeBg0Brush}"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Pane header: title, what the widths mean, and the basis as a segmented control.  -->
        <Border x:Name="ControlBar" Style="{StaticResource GaugePaneHeader}">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource GaugePaneTitle}" Text="Time attribution" />
                <TextBlock
                    x:Name="BasisFacts"
                    Grid.Column="1"
                    Style="{StaticResource GaugeFacts}"
                    Text="Bar width is the operator's share; children sit under their parent" />
                <Border
                    x:Name="BasisSelector"
                    Grid.Column="2"
                    AutomationProperties.Name="Attribution basis"
                    Style="{StaticResource GaugeSegmented}">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton
                            x:Name="ElapsedBasis"
                            Checked="OnBasisChanged"
                            Content="Elapsed time"
                            GroupName="FlameBasis"
                            IsChecked="True"
                            Style="{StaticResource GaugeSegmentItemFirst}" />
                        <RadioButton
                            x:Name="CpuBasis"
                            Checked="OnBasisChanged"
                            Content="CPU time"
                            GroupName="FlameBasis"
                            Style="{StaticResource GaugeSegmentItem}" />
                        <RadioButton
                            x:Name="RowsBasis"
                            Checked="OnBasisChanged"
                            Content="Rows read"
                            GroupName="FlameBasis"
                            Style="{StaticResource GaugeSegmentItem}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!--  Basis-reliability notes, shown only when relevant  -->
        <StackPanel
            Grid.Row="1"
            Margin="14,10,14,0"
            Spacing="8">
            <Border
                x:Name="ApproximateWarning"
                Style="{StaticResource GaugeCallout}"
                Visibility="Collapsed">
                <StackPanel Spacing="2">
                    <TextBlock Style="{StaticResource GaugeSevNeutral}" Text="Widths are approximate under parallelism" />
                    <TextBlock Style="{StaticResource GaugeCalloutText}" Text="Elapsed time is a max-across-threads figure below a parallel operator, so sibling widths here don't literally add up to their parent's. Switch to CPU time for an additive basis." />
                </StackPanel>
            </Border>

            <Border
                x:Name="NegativeSelfWarning"
                Style="{StaticResource GaugeCallout}"
                Visibility="Collapsed">
                <StackPanel Spacing="2">
                    <TextBlock Style="{StaticResource GaugeSevWarn}" Text="Warning · this basis doesn't fully account for its own children" />
                    <TextBlock x:Name="NegativeSelfWarningBody" Style="{StaticResource GaugeCalloutText}" />
                </StackPanel>
            </Border>
        </StackPanel>

        <!--  Shown in place of the flame chart when there are no runtime stats  -->
        <Border
            x:Name="DisabledPanel"
            Grid.Row="2"
            MaxWidth="520"
            Margin="14"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Style="{StaticResource GaugeCallout}"
            Visibility="Collapsed">
            <StackPanel Spacing="4">
                <TextBlock
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource GaugeFg0Brush}"
                    Text="No runtime stats to attribute" />
                <TextBlock Style="{StaticResource GaugeCalloutText}" Text="This is an estimated plan, so there is no actual elapsed time, CPU time or row count to build a flame view from. Capture an actual plan (Run for actual…) to use this view." />
            </StackPanel>
        </Border>

        <ScrollViewer
            x:Name="FlameScroller"
            Grid.Row="2"
            HorizontalScrollBarVisibility="Disabled"
            SizeChanged="OnScrollerSizeChanged"
            VerticalScrollBarVisibility="Auto">
            <Canvas
                x:Name="FlameCanvas"
                Margin="14,12,14,14"
                HorizontalAlignment="Left"
                VerticalAlignment="Top" />
        </ScrollViewer>
    </Grid>
</UserControl>
