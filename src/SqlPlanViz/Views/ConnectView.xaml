<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="SqlPlanViz.Views.ConnectView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel Width="620" Spacing="12">

        <ComboBox
            x:Name="EntryModeBox"
            HorizontalAlignment="Stretch"
            Header="Connection input"
            SelectionChanged="OnEntryModeChanged">
            <ComboBoxItem Content="Enter details" />
            <ComboBoxItem Content="Paste connection string" />
        </ComboBox>

        <StackPanel x:Name="DetailsPanel" Spacing="12">

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <AutoSuggestBox
                    x:Name="ServerBox"
                    Header="Server"
                    PlaceholderText="localhost\SQLEXPRESS"
                    SuggestionChosen="OnServerSuggestionChosen"
                    TextChanged="OnServerTextChanged" />
                <AutoSuggestBox
                    x:Name="DatabaseBox"
                    Grid.Column="1"
                    Header="Database"
                    PlaceholderText="(default)"
                    TextChanged="OnDatabaseTextChanged" />
            </Grid>

            <ComboBox
                x:Name="AuthBox"
                HorizontalAlignment="Stretch"
                Header="Authentication"
                SelectionChanged="OnAuthChanged">
                <ComboBoxItem Content="Windows Authentication" />
                <ComboBoxItem Content="SQL Server Authentication" />
                <ComboBoxItem Content="Microsoft Entra MFA" />
            </ComboBox>

            <StackPanel
                x:Name="SqlAuthPanel"
                Spacing="8"
                Visibility="Collapsed">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="UserBox" Header="Login" TextChanged="OnUserTextChanged" />
                    <PasswordBox
                        x:Name="PasswordBox"
                        Grid.Column="1"
                        Header="Password" />
                </Grid>
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <CheckBox
                        x:Name="RememberPasswordBox"
                        Content="Remember password"
                        ToolTipService.ToolTip="Stores the password for this server and login in Windows Credential Manager. Opt-in and revocable." />
                    <Button
                        x:Name="ForgetPasswordButton"
                        Content="Forget saved password"
                        Click="OnForgetPassword"
                        IsEnabled="False" />
                </StackPanel>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="16">
                <CheckBox x:Name="EncryptBox" Content="Encrypt connection" IsChecked="True" />
                <CheckBox
                    x:Name="TrustCertBox"
                    Content="Trust server certificate"
                    IsChecked="True"
                    ToolTipService.ToolTip="Needed for a dev instance using a self-signed certificate." />
            </StackPanel>

        </StackPanel>

        <TextBox
            x:Name="ConnectionStringBox"
            AcceptsReturn="True"
            FontFamily="Cascadia Mono, Consolas"
            FontSize="12"
            Header="Connection string"
            Height="120"
            PlaceholderText="Server=tcp:host,1433;Database=mydb;Authentication=Active Directory Interactive;Encrypt=True;"
            TextWrapping="Wrap"
            Visibility="Collapsed" />

        <TextBox
            x:Name="QueryBox"
            AcceptsReturn="True"
            FontFamily="Cascadia Mono, Consolas"
            FontSize="12"
            Header="Query"
            Height="180"
            PlaceholderText="SELECT * FROM dbo.Orders WHERE CustomerId = 42;"
            TextWrapping="NoWrap" />

        <RadioButtons x:Name="ModeButtons" SelectedIndex="0">
            <x:String>Actual plan — runs the query (SET STATISTICS XML ON)</x:String>
            <x:String>Estimated plan only — compiles without running it (SET SHOWPLAN_XML ON)</x:String>
        </RadioButtons>

        <StackPanel Orientation="Horizontal" Spacing="12">
            <Button x:Name="TestButton" Click="OnTestConnection" Content="Test connection" />
            <TextBlock
                x:Name="TestResult"
                VerticalAlignment="Center"
                FontSize="12"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextTrimming="CharacterEllipsis"
                TextWrapping="NoWrap" />
        </StackPanel>

        <InfoBar
            IsClosable="False"
            IsOpen="True"
            Message="Recent servers and logins are remembered on this PC, a SQL password is never written to disk and is kept only in Windows Credential Manager when you tick &quot;Remember password&quot;, and Microsoft Entra sign-in tokens stay cached in memory until the app closes."
            Severity="Informational" />
    </StackPanel>
</UserControl>
