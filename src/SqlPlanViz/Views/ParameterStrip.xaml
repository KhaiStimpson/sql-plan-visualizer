<UserControl
    x:Class="SqlPlanViz.Views.ParameterStrip"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:SqlPlanViz.ViewModels"
    xmlns:local="using:SqlPlanViz.Views"
    mc:Ignorable="d">

    <!--
        The strip under the editor (docs/live-plan-editor-plan.md Phase 3). Collapses itself
        when the batch needs no parameters, so an unparameterised query costs no vertical
        space in a pane that is already competing with the plan for it.
    -->
    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Padding="10,4" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ToggleButton
                x:Name="ExpandToggle"
                Padding="6,2"
                Background="Transparent"
                BorderThickness="0"
                Click="OnToggleExpanded"
                IsChecked="True">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon
                        x:Name="ExpandGlyph"
                        FontFamily="Segoe Fluent Icons"
                        FontSize="10"
                        Glyph="&#xE70D;" />
                    <TextBlock
                        x:Name="HeaderText"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Text="Parameters" />
                </StackPanel>
            </ToggleButton>

            <TextBlock
                x:Name="HintText"
                Grid.Column="1"
                VerticalAlignment="Center"
                FontSize="11"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                TextTrimming="CharacterEllipsis" />

            <Button
                x:Name="ResetButton"
                Grid.Column="2"
                Padding="8,2"
                Click="OnResetAll"
                Content="Reset to plan values"
                FontSize="11" />
        </Grid>

        <ItemsControl
            x:Name="ItemsHost"
            Grid.Row="1"
            Padding="10,0,10,8"
            >
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Spacing="4" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplateSelector>
                <local:ParameterEditorTemplateSelector>
                    <local:ParameterEditorTemplateSelector.DefaultTemplate>
                        <DataTemplate x:DataType="vm:ParameterBindingItem">
                            <Grid
                                Padding="8,6"
                                Background="{x:Bind RowIndex, Mode=OneWay, Converter={StaticResource RowIndexToAlternateBrush}}"
                                ColumnSpacing="8"
                                RowSpacing="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup>
                                        <VisualState x:Name="NarrowRow">
                                            <VisualState.StateTriggers>
                                                <AdaptiveTrigger MinWindowWidth="0" />
                                            </VisualState.StateTriggers>
                                            <VisualState.Setters>
                                                <Setter Target="ValueGroup.(Grid.Row)" Value="1" />
                                                <Setter Target="ValueGroup.(Grid.Column)" Value="0" />
                                                <Setter Target="ValueGroup.(Grid.ColumnSpan)" Value="3" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="WideRow">
                                            <VisualState.StateTriggers>
                                                <AdaptiveTrigger MinWindowWidth="480" />
                                            </VisualState.StateTriggers>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>

                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontFamily="Cascadia Mono, Consolas"
                                    FontSize="12"
                                    Text="{x:Bind Name}"
                                    ToolTipService.ToolTip="{x:Bind TypeSourceHint}" />

                                <AutoSuggestBox
                                    Grid.Column="1"
                                    FontSize="12"
                                    GotFocus="OnDataTypeGotFocus"
                                    PlaceholderText="type"
                                    SuggestionChosen="OnDataTypeSuggestionChosen"
                                    Text="{x:Bind DataType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    TextChanged="OnDataTypeTextChanged" />

                                <Grid
                                    x:Name="ValueGroup"
                                    Grid.Row="0"
                                    Grid.Column="2"
                                    ColumnSpacing="8"
                                    Visibility="{x:Bind IsScalar, Converter={StaticResource BoolToVisibility}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBox
                                        FontFamily="Cascadia Mono, Consolas"
                                        FontSize="12"
                                        IsEnabled="{x:Bind IsNull, Mode=OneWay, Converter={StaticResource InverseBool}}"
                                        IsSpellCheckEnabled="False"
                                        PlaceholderText="value"
                                        Text="{x:Bind Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                    <CheckBox
                                        Grid.Column="1"
                                        MinWidth="0"
                                        Content="NULL"
                                        FontSize="11"
                                        IsChecked="{x:Bind IsNull, Mode=TwoWay}" />
                                </Grid>

                                <TextBlock
                                    Grid.Row="2"
                                    Grid.Column="1"
                                    Grid.ColumnSpan="2"
                                    Margin="2,2,0,0"
                                    FontSize="11"
                                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                    Text="{x:Bind ValidationMessage, Mode=OneWay}"
                                    TextWrapping="Wrap"
                                    Visibility="{x:Bind ValidationMessage, Mode=OneWay, Converter={StaticResource StringToVisibility}}" />
                            </Grid>
                        </DataTemplate>
                    </local:ParameterEditorTemplateSelector.DefaultTemplate>

                    <local:ParameterEditorTemplateSelector.NumericTemplate>
                        <DataTemplate x:DataType="vm:ParameterBindingItem">
                            <Grid
                                Padding="8,6"
                                Background="{x:Bind RowIndex, Mode=OneWay, Converter={StaticResource RowIndexToAlternateBrush}}"
                                ColumnSpacing="8"
                                RowSpacing="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup>
                                        <VisualState x:Name="NarrowRow">
                                            <VisualState.StateTriggers>
                                                <AdaptiveTrigger MinWindowWidth="0" />
                                            </VisualState.StateTriggers>
                                            <VisualState.Setters>
                                                <Setter Target="ValueGroup.(Grid.Row)" Value="1" />
                                                <Setter Target="ValueGroup.(Grid.Column)" Value="0" />
                                                <Setter Target="ValueGroup.(Grid.ColumnSpan)" Value="3" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="WideRow">
                                            <VisualState.StateTriggers>
                                                <AdaptiveTrigger MinWindowWidth="480" />
                                            </VisualState.StateTriggers>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>

                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontFamily="Cascadia Mono, Consolas"
                                    FontSize="12"
                                    Text="{x:Bind Name}"
                                    ToolTipService.ToolTip="{x:Bind TypeSourceHint}" />

                                <AutoSuggestBox
                                    Grid.Column="1"
                                    FontSize="12"
                                    GotFocus="OnDataTypeGotFocus"
                                    PlaceholderText="type"
                                    SuggestionChosen="OnDataTypeSuggestionChosen"
                                    Text="{x:Bind DataType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    TextChanged="OnDataTypeTextChanged" />

                                <Grid
                                    x:Name="ValueGroup"
                                    Grid.Row="0"
                                    Grid.Column="2"
                                    ColumnSpacing="8"
                                    Visibility="{x:Bind IsScalar, Converter={StaticResource BoolToVisibility}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <NumberBox
                                        FontFamily="Cascadia Mono, Consolas"
                                        FontSize="12"
                                        IsEnabled="{x:Bind IsNull, Mode=OneWay, Converter={StaticResource InverseBool}}"
                                        PlaceholderText="value"
                                        SpinButtonPlacementMode="Compact"
                                        Value="{x:Bind Value, Mode=TwoWay, Converter={StaticResource StringToDouble}}" />

                                    <CheckBox
                                        Grid.Column="1"
                                        MinWidth="0"
                                        Content="NULL"
                                        FontSize="11"
                                        IsChecked="{x:Bind IsNull, Mode=TwoWay}" />
                                </Grid>

                                <TextBlock
                                    Grid.Row="2"
                                    Grid.Column="1"
                                    Grid.ColumnSpan="2"
                                    Margin="2,2,0,0"
                                    FontSize="11"
                                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                    Text="{x:Bind ValidationMessage, Mode=OneWay}"
                                    TextWrapping="Wrap"
                                    Visibility="{x:Bind ValidationMessage, Mode=OneWay, Converter={StaticResource StringToVisibility}}" />
                            </Grid>
                        </DataTemplate>
                    </local:ParameterEditorTemplateSelector.NumericTemplate>

                    <local:ParameterEditorTemplateSelector.BitTemplate>
                        <DataTemplate x:DataType="vm:ParameterBindingItem">
                            <Grid
                                Padding="8,6"
                                Background="{x:Bind RowIndex, Mode=OneWay, Converter={StaticResource RowIndexToAlternateBrush}}"
                                ColumnSpacing="8"
                                RowSpacing="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup>
                                        <VisualState x:Name="NarrowRow">
                                            <VisualState.StateTriggers>
                                                <AdaptiveTrigger MinWindowWidth="0" />
                                            </VisualState.StateTriggers>
                                            <VisualState.Setters>
                                                <Setter Target="ValueGroup.(Grid.Row)" Value="1" />
                                                <Setter Target="ValueGroup.(Grid.Column)" Value="0" />
                                                <Setter Target="ValueGroup.(Grid.ColumnSpan)" Value="3" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="WideRow">
                                            <VisualState.StateTriggers>
                                                <AdaptiveTrigger MinWindowWidth="480" />
                                            </VisualState.StateTriggers>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>

                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontFamily="Cascadia Mono, Consolas"
                                    FontSize="12"
                                    Text="{x:Bind Name}"
                                    ToolTipService.ToolTip="{x:Bind TypeSourceHint}" />

                                <AutoSuggestBox
                                    Grid.Column="1"
                                    FontSize="12"
                                    GotFocus="OnDataTypeGotFocus"
                                    PlaceholderText="type"
                                    SuggestionChosen="OnDataTypeSuggestionChosen"
                                    Text="{x:Bind DataType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    TextChanged="OnDataTypeTextChanged" />

                                <Grid
                                    x:Name="ValueGroup"
                                    Grid.Row="0"
                                    Grid.Column="2"
                                    ColumnSpacing="8"
                                    Visibility="{x:Bind IsScalar, Converter={StaticResource BoolToVisibility}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <ToggleSwitch
                                        MinWidth="0"
                                        Padding="0"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        IsEnabled="{x:Bind IsNull, Mode=OneWay, Converter={StaticResource InverseBool}}"
                                        IsOn="{x:Bind Value, Mode=TwoWay, Converter={StaticResource StringToBool}}"
                                        OffContent=""
                                        OnContent="" />

                                    <CheckBox
                                        Grid.Column="1"
                                        MinWidth="0"
                                        Content="NULL"
                                        FontSize="11"
                                        IsChecked="{x:Bind IsNull, Mode=TwoWay}" />
                                </Grid>

                                <TextBlock
                                    Grid.Row="2"
                                    Grid.Column="1"
                                    Grid.ColumnSpan="2"
                                    Margin="2,2,0,0"
                                    FontSize="11"
                                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                    Text="{x:Bind ValidationMessage, Mode=OneWay}"
                                    TextWrapping="Wrap"
                                    Visibility="{x:Bind ValidationMessage, Mode=OneWay, Converter={StaticResource StringToVisibility}}" />
                            </Grid>
                        </DataTemplate>
                    </local:ParameterEditorTemplateSelector.BitTemplate>

                    <local:ParameterEditorTemplateSelector.DateTimeTemplate>
                        <DataTemplate x:DataType="vm:ParameterBindingItem">
                            <Grid
                                Padding="8,6"
                                Background="{x:Bind RowIndex, Mode=OneWay, Converter={StaticResource RowIndexToAlternateBrush}}"
                                ColumnSpacing="8"
                                RowSpacing="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup>
                                        <VisualState x:Name="NarrowRow">
                                            <VisualState.StateTriggers>
                                                <AdaptiveTrigger MinWindowWidth="0" />
                                            </VisualState.StateTriggers>
                                            <VisualState.Setters>
                                                <Setter Target="ValueGroup.(Grid.Row)" Value="1" />
                                                <Setter Target="ValueGroup.(Grid.Column)" Value="0" />
                                                <Setter Target="ValueGroup.(Grid.ColumnSpan)" Value="3" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="WideRow">
                                            <VisualState.StateTriggers>
                                                <AdaptiveTrigger MinWindowWidth="480" />
                                            </VisualState.StateTriggers>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>

                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontFamily="Cascadia Mono, Consolas"
                                    FontSize="12"
                                    Text="{x:Bind Name}"
                                    ToolTipService.ToolTip="{x:Bind TypeSourceHint}" />

                                <AutoSuggestBox
                                    Grid.Column="1"
                                    FontSize="12"
                                    GotFocus="OnDataTypeGotFocus"
                                    PlaceholderText="type"
                                    SuggestionChosen="OnDataTypeSuggestionChosen"
                                    Text="{x:Bind DataType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    TextChanged="OnDataTypeTextChanged" />

                                <Grid
                                    x:Name="ValueGroup"
                                    Grid.Row="0"
                                    Grid.Column="2"
                                    ColumnSpacing="4"
                                    Visibility="{x:Bind IsScalar, Converter={StaticResource BoolToVisibility}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <CalendarDatePicker
                                        FontSize="12"
                                        Date="{x:Bind DateValue, Mode=TwoWay}"
                                        IsEnabled="{x:Bind IsNull, Mode=OneWay, Converter={StaticResource InverseBool}}"
                                        PlaceholderText="date" />

                                    <TextBox
                                        Grid.Column="1"
                                        FontFamily="Cascadia Mono, Consolas"
                                        FontSize="12"
                                        IsEnabled="{x:Bind IsNull, Mode=OneWay, Converter={StaticResource InverseBool}}"
                                        IsSpellCheckEnabled="False"
                                        PlaceholderText="HH:mm:ss"
                                        Text="{x:Bind TimeText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                    <CheckBox
                                        Grid.Column="2"
                                        MinWidth="0"
                                        Content="NULL"
                                        FontSize="11"
                                        IsChecked="{x:Bind IsNull, Mode=TwoWay}" />
                                </Grid>

                                <TextBlock
                                    Grid.Row="2"
                                    Grid.Column="1"
                                    Grid.ColumnSpan="2"
                                    Margin="2,2,0,0"
                                    FontSize="11"
                                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                    Text="{x:Bind ValidationMessage, Mode=OneWay}"
                                    TextWrapping="Wrap"
                                    Visibility="{x:Bind ValidationMessage, Mode=OneWay, Converter={StaticResource StringToVisibility}}" />
                            </Grid>
                        </DataTemplate>
                    </local:ParameterEditorTemplateSelector.DateTimeTemplate>
                </local:ParameterEditorTemplateSelector>
            </ItemsControl.ItemTemplateSelector>
        </ItemsControl>

        <!--
            Table-valued parameters get a row grid shaped by their columns, which is built in
            code: the shape is not known until a table type is chosen, so there is no fixed
            template to write for it.
        -->
        <StackPanel
            x:Name="TableHost"
            Grid.Row="2"
            Padding="10,0,10,8"
            Spacing="8" />
    </Grid>
</UserControl>
